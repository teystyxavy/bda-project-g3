      "mode": "managed",
      "type": "aws_sfn_state_machine",
      "name": "ingest",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:states:ap-southeast-1:588738581042:stateMachine:is459-g3-ingest",
            "creation_date": "2026-10-06T04:23:14Z",
            "definition": "{\r\n  \"Comment\": \"Parallel verified full batch; 15-second bounded processing checks; no paid-job retries.\",\r\n  \"StartAt\": \"Begin\",\r\n  \"TimeoutSeconds\": 7200,\r\n  \"States\": {\r\n    \"Begin\": {\r\n      \"Type\": \"Task\",\r\n      \"Resource\": \"arn:aws:lambda:ap-southeast-1:588738581042:function:is459-g3-ingest-control\",\r\n      \"Parameters\": {\r\n        \"op\": \"begin\",\r\n        \"run_id.$\": \"$.run_id\"\r\n      },\r\n      \"ResultPath\": \"$.work\",\r\n      \"Next\": \"ReuseCurated\",\r\n      \"Retry\": [\r\n        {\r\n          \"ErrorEquals\": [\r\n            \"Lambda.ServiceException\",\r\n            \"Lambda.AWSLambdaException\",\r\n            \"Lambda.SdkClientException\",\r\n            \"Lambda.TooManyRequestsException\"\r\n          ],\r\n          \"IntervalSeconds\": 3,\r\n          \"MaxAttempts\": 2,\r\n          \"BackoffRate\": 2\r\n        }\r\n      ],\r\n      \"Catch\": [\r\n        {\r\n          \"ErrorEquals\": [\r\n            \"States.ALL\"\r\n          ],\r\n          \"ResultPath\": \"$.failure\",\r\n          \"Next\": \"RecordFailure\"\r\n        }\r\n      ]\r\n    },\r\n    \"ReuseCurated\": {\r\n      \"Type\": \"Choice\",\r\n      \"Choices\": [\r\n        {\r\n          \"Variable\": \"$.work.curated_cache_hit\",\r\n          \"BooleanEquals\": true,\r\n          \"Next\": \"PrepareBaseline\"\r\n        }\r\n      ],\r\n      \"Default\": \"Curate\"\r\n    },\r\n    \"Curate\": {\r\n      \"Type\": \"Task\",\r\n      \"Resource\": \"arn:aws:states:::glue:startJobRun.sync\",\r\n      \"Parameters\": {\r\n        \"JobName\": \"is459-g3-ingest-curate\",\r\n        \"Arguments.$\": \"$.work.curate_arguments\"\r\n      },\r\n      \"ResultPath\": null,\r\n      \"Next\": \"PrepareBaseline\",\r\n      \"Catch\": [\r\n        {\r\n          \"ErrorEquals\": [\r\n            \"States.ALL\"\r\n          ],\r\n          \"ResultPath\": \"$.failure\",\r\n          \"Next\": \"RecordFailure\"\r\n        }\r\n      ]\r\n    },\r\n    \"PrepareBaseline\": {\r\n      \"Type\": \"Task\",\r\n      \"Resource\": \"arn:aws:lambda:ap-southeast-1:588738581042:function:is459-g3-ingest-control\",\r\n      \"Parameters\": {\r\n        \"op\": \"curated\",\r\n        \"run_id.$\": \"$.run_id\"\r\n      },\r\n      \"ResultPath\": \"$.baseline_request\",\r\n      \"Next\": \"ScoreAndAnalyze\",\r\n      \"Retry\": [\r\n        {\r\n          \"ErrorEquals\": [\r\n            \"Lambda.ServiceException\",\r\n            \"Lambda.AWSLambdaException\",\r\n            \"Lambda.SdkClientException\",\r\n            \"Lambda.TooManyRequestsException\"\r\n          ],\r\n          \"IntervalSeconds\": 3,\r\n          \"MaxAttempts\": 2,\r\n          \"BackoffRate\": 2\r\n        }\r\n      ],\r\n      \"Catch\": [\r\n        {\r\n          \"ErrorEquals\": [\r\n            \"States.ALL\"\r\n          ],\r\n          \"ResultPath\": \"$.failure\",\r\n          \"Next\": \"RecordFailure\"\r\n        }\r\n      ]\r\n    },\r\n    \"ScoreAndAnalyze\": {\r\n      \"Type\": \"Parallel\",\r\n      \"Branches\": [\r\n        {\r\n          \"StartAt\": \"Baseline\",\r\n          \"States\": {\r\n            \"Baseline\": {\r\n              \"Type\": \"Task\",\r\n              \"Resource\": \"arn:aws:states:::aws-sdk:sagemaker:createProcessingJob\",\r\n              \"Parameters\": {\r\n                \"ProcessingJobName.$\": \"$.baseline_request.ProcessingJobName\",\r\n                \"RoleArn.$\": \"$.baseline_request.RoleArn\",\r\n                \"AppSpecification.$\": \"$.baseline_request.AppSpecification\",\r\n                \"ProcessingInputs.$\": \"$.baseline_request.ProcessingInputs\",\r\n                \"ProcessingOutputConfig.$\": \"$.baseline_request.ProcessingOutputConfig\",\r\n                \"ProcessingResources.$\": \"$.baseline_request.ProcessingResources\",\r\n                \"StoppingCondition.$\": \"$.baseline_request.StoppingCondition\",\r\n                \"NetworkConfig.$\": \"$.baseline_request.NetworkConfig\",\r\n                \"Tags.$\": \"$.baseline_request.Tags\"\r\n              },\r\n              \"ResultPath\": null,\r\n              \"Next\": \"BaselinePollInit\"\r\n            },\r\n            \"BaselinePollInit\": {\r\n              \"Type\": \"Pass\",\r\n              \"Result\": {\r\n                \"attempt\": 0\r\n              },\r\n              \"ResultPath\": \"$.poll\",\r\n              \"Next\": \"BaselineWait\"\r\n            },\r\n            \"BaselineWait\": {\r\n              \"Type\": \"Wait\",\r\n              \"Seconds\": 15,\r\n              \"Next\": \"BaselineStatus\"\r\n            },\r\n            \"BaselineStatus\": {\r\n              \"Type\": \"Task\",\r\n              \"Resource\": \"arn:aws:states:::aws-sdk:sagemaker:describeProcessingJob\",\r\n              \"Parameters\": {\r\n                \"ProcessingJobName.$\": \"$.baseline_request.ProcessingJobName\"\r\n              },\r\n              \"ResultSelector\": {\r\n                \"status.$\": \"$.ProcessingJobStatus\"\r\n              },\r\n              \"ResultPath\": \"$.job_status\",\r\n              \"Next\": \"BaselineComplete\",\r\n              \"Retry\": [\r\n                {\r\n                  \"ErrorEquals\": [\r\n                    \"States.TaskFailed\"\r\n                  ],\r\n                  \"IntervalSeconds\": 3,\r\n                  \"MaxAttempts\": 2,\r\n                  \"BackoffRate\": 2\r\n                }\r\n              ]\r\n            },\r\n            \"BaselineComplete\": {\r\n              \"Type\": \"Choice\",\r\n              \"Choices\": [\r\n                {\r\n                  \"Variable\": \"$.job_status.status\",\r\n                  \"StringEquals\": \"Completed\",\r\n                  \"Next\": \"PrepareBranches\"\r\n                },\r\n                {\r\n                  \"Or\": [\r\n                    {\r\n                      \"Variable\": \"$.job_status.status\",\r\n                      \"StringEquals\": \"Failed\"\r\n                    },\r\n                    {\r\n                      \"Variable\": \"$.job_status.status\",\r\n                      \"StringEquals\": \"Stopped\"\r\n                    }\r\n                  ],\r\n                  \"Next\": \"BaselineFailed\"\r\n                },\r\n                {\r\n                  \"Variable\": \"$.poll.attempt\",\r\n                  \"NumericGreaterThanEquals\": 179,\r\n                  \"Next\": \"BaselineFailed\"\r\n                }\r\n              ],\r\n              \"Default\": \"BaselinePollIncrement\"\r\n            },\r\n            \"BaselinePollIncrement\": {\r\n              \"Type\": \"Pass\",\r\n              \"Parameters\": {\r\n                \"attempt.$\": \"States.MathAdd($.poll.attempt, 1)\"\r\n              },\r\n              \"ResultPath\": \"$.poll\",\r\n              \"Next\": \"BaselineWait\"\r\n            },\r\n            \"BaselineFailed\": {\r\n              \"Type\": \"Fail\",\r\n              \"Error\": \"ProcessingFailedOrDeadline\",\r\n              \"Cause\": \"Processing did not succeed within 180 checks; preserve outputs and stop owned workers.\"\r\n            },\r\n            \"PrepareBranches\": {\r\n              \"Type\": \"Task\",\r\n              \"Resource\": \"arn:aws:lambda:ap-southeast-1:588738581042:function:is459-g3-ingest-control\",\r\n              \"Parameters\": {\r\n                \"op\": \"baseline\",\r\n                \"run_id.$\": \"$.run_id\"\r\n              },\r\n              \"ResultPath\": \"$.training\",\r\n              \"Next\": \"TrainRequested\",\r\n              \"Retry\": [\r\n                {\r\n                  \"ErrorEquals\": [\r\n                    \"Lambda.ServiceException\",\r\n                    \"Lambda.AWSLambdaException\",\r\n                    \"Lambda.SdkClientException\",\r\n                    \"Lambda.TooManyRequestsException\"\r\n                  ],\r\n                  \"IntervalSeconds\": 3,\r\n                  \"MaxAttempts\": 2,\r\n                  \"BackoffRate\": 2\r\n                }\r\n              ]\r\n            },\r\n            \"TrainRequested\": {\r\n              \"Type\": \"Choice\",\r\n              \"Choices\": [\r\n                {\r\n                  \"Variable\": \"$.work.train\",\r\n                  \"BooleanEquals\": true,\r\n                  \"Next\": \"Train\"\r\n                }\r\n              ],\r\n              \"Default\": \"ReuseFrozen\"\r\n            },\r\n            \"TrainDone\": {\r\n              \"Type\": \"Pass\",\r\n              \"End\": true\r\n            },\r\n            \"ReuseFrozen\": {\r\n              \"Type\": \"Pass\",\r\n              \"End\": true\r\n            },\r\n            \"Train\": {\r\n              \"Type\": \"Task\",\r\n              \"Resource\": \"arn:aws:states:::aws-sdk:sagemaker:createTrainingJob\",\r\n              \"Parameters\": {\r\n                \"TrainingJobName.$\": \"$.training.training_request.TrainingJobName\",\r\n                \"RoleArn.$\": \"$.training.training_request.RoleArn\",\r\n                \"AlgorithmSpecification.$\": \"$.training.training_request.AlgorithmSpecification\",\r\n                \"InputDataConfig.$\": \"$.training.training_request.InputDataConfig\",\r\n                \"OutputDataConfig.$\": \"$.training.training_request.OutputDataConfig\",\r\n                \"ResourceConfig.$\": \"$.training.training_request.ResourceConfig\",\r\n                \"StoppingCondition.$\": \"$.training.training_request.StoppingCondition\",\r\n                \"HyperParameters.$\": \"$.training.training_request.HyperParameters\",\r\n                \"EnableNetworkIsolation.$\": \"$.training.training_request.EnableNetworkIsolation\",\r\n                \"EnableManagedSpotTraining.$\": \"$.training.training_request.EnableManagedSpotTraining\",\r\n                \"EnableInterContainerTrafficEncryption.$\": \"$.training.training_request.EnableInterContainerTrafficEncryption\",\r\n                \"ProfilerConfig.$\": \"$.training.training_request.ProfilerConfig\",\r\n                \"Tags.$\": \"$.training.training_request.Tags\"\r\n              },\r\n              \"ResultPath\": null,\r\n              \"Next\": \"TrainPollInit\"\r\n            },\r\n            \"TrainPollInit\": {\r\n              \"Type\": \"Pass\",\r\n              \"Result\": {\r\n                \"attempt\": 0\r\n              },\r\n              \"ResultPath\": \"$.poll\",\r\n              \"Next\": \"TrainWait\"\r\n            },\r\n            \"TrainWait\": {\r\n              \"Type\": \"Wait\",\r\n              \"Seconds\": 15,\r\n              \"Next\": \"TrainStatus\"\r\n            },\r\n            \"TrainStatus\": {\r\n              \"Type\": \"Task\",\r\n              \"Resource\": \"arn:aws:states:::aws-sdk:sagemaker:describeTrainingJob\",\r\n              \"Parameters\": {\r\n                \"TrainingJobName.$\": \"$.training.training_request.TrainingJobName\"\r\n              },\r\n              \"ResultSelector\": {\r\n                \"status.$\": \"$.TrainingJobStatus\"\r\n              },\r\n              \"ResultPath\": \"$.job_status\",\r\n              \"Next\": \"TrainComplete\",\r\n              \"Retry\": [\r\n                {\r\n                  \"ErrorEquals\": [\r\n                    \"States.TaskFailed\"\r\n                  ],\r\n                  \"IntervalSeconds\": 3,\r\n                  \"MaxAttempts\": 2,\r\n                  \"BackoffRate\": 2\r\n                }\r\n              ]\r\n            },\r\n            \"TrainComplete\": {\r\n              \"Type\": \"Choice\",\r\n              \"Choices\": [\r\n                {\r\n                  \"Variable\": \"$.job_status.status\",\r\n                  \"StringEquals\": \"Completed\",\r\n                  \"Next\": \"TrainDone\"\r\n                },\r\n                {\r\n                  \"Or\": [\r\n                    {\r\n                      \"Variable\": \"$.job_status.status\",\r\n                      \"StringEquals\": \"Failed\"\r\n                    },\r\n                    {\r\n                      \"Variable\": \"$.job_status.status\",\r\n                      \"StringEquals\": \"Stopped\"\r\n                    }\r\n                  ],\r\n                  \"Next\": \"TrainFailed\"\r\n                },\r\n                {\r\n                  \"Variable\": \"$.poll.attempt\",\r\n                  \"NumericGreaterThanEquals\": 179,\r\n                  \"Next\": \"TrainFailed\"\r\n                }\r\n              ],\r\n              \"Default\": \"TrainPollIncrement\"\r\n            },\r\n            \"TrainPollIncrement\": {\r\n              \"Type\": \"Pass\",\r\n              \"Parameters\": {\r\n                \"attempt.$\": \"States.MathAdd($.poll.attempt, 1)\"\r\n              },\r\n              \"ResultPath\": \"$.poll\",\r\n              \"Next\": \"TrainWait\"\r\n            },\r\n            \"TrainFailed\": {\r\n              \"Type\": \"Fail\",\r\n              \"Error\": \"ProcessingFailedOrDeadline\",\r\n              \"Cause\": \"Processing did not succeed within 180 checks; preserve outputs and stop owned workers.\"\r\n            }\r\n          }\r\n        },\r\n        {\r\n          \"StartAt\": \"ReuseScores\",\r\n          \"States\": {\r\n            \"ReuseScores\": {\r\n              \"Type\": \"Choice\",\r\n              \"Choices\": [\r\n                {\r\n                  \"Variable\": \"$.work.scored_cache_hit\",\r\n                  \"BooleanEquals\": true,\r\n                  \"Next\": \"ScoresReused\"\r\n                }\r\n              ],\r\n              \"Default\": \"Score\"\r\n            },\r\n            \"Score\": {\r\n              \"Type\": \"Task\",\r\n              \"Resource\": \"arn:aws:states:::glue:startJobRun.sync\",\r\n              \"Parameters\": {\r\n                \"JobName\": \"is459-g3-ingest-score\",\r\n                \"Arguments.$\": \"$.work.score_arguments\"\r\n              },\r\n              \"ResultPath\": null,\r\n              \"End\": true\r\n            },\r\n            \"ScoresReused\": {\r\n              \"Type\": \"Pass\",\r\n              \"End\": true\r\n            }\r\n          }\r\n        },\r\n        {\r\n          \"StartAt\": \"Corridors\",\r\n          \"States\": {\r\n            \"Corridors\": {\r\n              \"Type\": \"Task\",\r\n              \"Resource\": \"arn:aws:states:::athena:startQueryExecution.sync\",\r\n              \"Parameters\": {\r\n                \"QueryString.$\": \"$.work.query\",\r\n                \"ClientRequestToken.$\": \"$.work.query_token\",\r\n                \"WorkGroup\": \"is459-g3-analysis\",\r\n                \"QueryExecutionContext\": {\r\n                  \"Database\": \"is459_g3_ingest\"\r\n                }\r\n              },\r\n              \"ResultPath\": null,\r\n              \"End\": true\r\n            }\r\n          }\r\n        }\r\n      ],\r\n      \"ResultPath\": null,\r\n      \"Next\": \"PrepareExport\",\r\n      \"Catch\": [\r\n        {\r\n          \"ErrorEquals\": [\r\n            \"States.ALL\"\r\n          ],\r\n          \"ResultPath\": \"$.failure\",\r\n          \"Next\": \"RecordFailure\"\r\n        }\r\n      ]\r\n    },\r\n    \"PrepareExport\": {\r\n      \"Type\": \"Task\",\r\n      \"Resource\": \"arn:aws:lambda:ap-southeast-1:588738581042:function:is459-g3-ingest-control\",\r\n      \"Parameters\": {\r\n        \"op\": \"export\",\r\n        \"run_id.$\": \"$.run_id\",\r\n        \"work.$\": \"$.work\"\r\n      },\r\n      \"ResultPath\": \"$.export_request\",\r\n      \"Next\": \"Export\",\r\n      \"Retry\": [\r\n        {\r\n          \"ErrorEquals\": [\r\n            \"Lambda.ServiceException\",\r\n            \"Lambda.AWSLambdaException\",\r\n            \"Lambda.SdkClientException\",\r\n            \"Lambda.TooManyRequestsException\"\r\n          ],\r\n          \"IntervalSeconds\": 3,\r\n          \"MaxAttempts\": 2,\r\n          \"BackoffRate\": 2\r\n        }\r\n      ],\r\n      \"Catch\": [\r\n        {\r\n          \"ErrorEquals\": [\r\n            \"States.ALL\"\r\n          ],\r\n          \"ResultPath\": \"$.failure\",\r\n          \"Next\": \"RecordFailure\"\r\n        }\r\n      ]\r\n    },\r\n    \"Export\": {\r\n      \"Type\": \"Task\",\r\n      \"Resource\": \"arn:aws:states:::aws-sdk:sagemaker:createProcessingJob\",\r\n      \"Parameters\": {\r\n        \"ProcessingJobName.$\": \"$.export_request.ProcessingJobName\",\r\n        \"RoleArn.$\": \"$.export_request.RoleArn\",\r\n        \"AppSpecification.$\": \"$.export_request.AppSpecification\",\r\n        \"ProcessingInputs.$\": \"$.export_request.ProcessingInputs\",\r\n        \"ProcessingOutputConfig.$\": \"$.export_request.ProcessingOutputConfig\",\r\n        \"ProcessingResources.$\": \"$.export_request.ProcessingResources\",\r\n        \"StoppingCondition.$\": \"$.export_request.StoppingCondition\",\r\n        \"NetworkConfig.$\": \"$.export_request.NetworkConfig\",\r\n        \"Tags.$\": \"$.export_request.Tags\"\r\n      },\r\n      \"ResultPath\": null,\r\n      \"Next\": \"ExportPollInit\",\r\n      \"Catch\": [\r\n        {\r\n          \"ErrorEquals\": [\r\n            \"States.ALL\"\r\n          ],\r\n          \"ResultPath\": \"$.failure\",\r\n          \"Next\": \"RecordFailure\"\r\n        }\r\n      ]\r\n    },\r\n    \"ExportPollInit\": {\r\n      \"Type\": \"Pass\",\r\n      \"Result\": {\r\n        \"attempt\": 0\r\n      },\r\n      \"ResultPath\": \"$.poll\",\r\n      \"Next\": \"ExportWait\"\r\n    },\r\n    \"ExportWait\": {\r\n      \"Type\": \"Wait\",\r\n      \"Seconds\": 15,\r\n      \"Next\": \"ExportStatus\"\r\n    },\r\n    \"ExportStatus\": {\r\n      \"Type\": \"Task\",\r\n      \"Resource\": \"arn:aws:states:::aws-sdk:sagemaker:describeProcessingJob\",\r\n      \"Parameters\": {\r\n   