            },
            "Resource": "arn:aws:states:::aws-sdk:s3:listObjectsV2",
            "ResultPath": "$.inventory",
            "Retry": [
              {
                "BackoffRate": 2,
                "ErrorEquals": [
                  "S3.SlowDownException",
                  "S3.InternalErrorException"
                ],
                "IntervalSeconds": 2,
                "JitterStrategy": "FULL",
                "MaxAttempts": 2
              }
            ],
            "TimeoutSeconds": 30,
            "Type": "Task"
          },
          "CheckFreshTemp": {
