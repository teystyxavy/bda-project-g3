    {
      "mode": "managed",
      "type": "aws_sfn_state_machine",
      "name": "batch",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "index_key": 0,
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:states:ap-southeast-1:588738581042:stateMachine:is459-g3-reviewed-batch",
            "creation_date": "2026-10-05T23:03:24Z",
            "definition": "{\r\n  \"Comment\": \"Frozen BQ1 scoring and BQ2 corridor query. Completion requires local reconciliation before any publication.\",\r\n  \"StartAt\": \"ValidateRequest\",\r\n  \"TimeoutSeconds\": 1800,\r\n  \"States\": {\r\n    \"ValidateRequest\": {\r\n      \"Type\": \"Choice\",\r\n      \"Choices\": [{\"And\": [\r\n        {\"Variable\": \"$.execution_approved\", \"IsPresent\": true},\r\n        {\"Variable\": \"$.execution_approved\", \"BooleanEquals\": true},\r\n        {\"Variable\": \"$.run_id\", \"IsPresent\": true},\r\n        {\"Variable\": \"$.run_id\", \"StringEquals\": \"full-orchestrated-20261006\"},\r\n        {\"Variable\": \"$$.Execution.Name\", \"StringEquals\": \"full-orchestrated-20261006\"},\r\n        {\"Variable\": \"$.expected_rows\", \"IsPresent\": true},\r\n        {\"Variable\": \"$.expected_rows\", \"NumericEquals\": 5078345}\r\n      ], \"Next\": \"GetFrozenJob\"}],\r\n      \"Default\": \"RequestRejected\"\r\n    },\r\n    \"RequestRejected\": {\"Type\": \"Fail\", \"Error\": \"UnapprovedOrMismatchedRequest\", \"Cause\": \"No paid task started; execution approval must follow the reviewed scope.\"},\r\n    \"GetFrozenJob\": {\r\n      \"Type\": \"Task\", \"Resource\": \"arn:aws:states:::aws-sdk:glue:getJob\",\r\n      \"Parameters\": {\"JobName\": \"is459-g3-score-frozen\"}, \"ResultPath\": \"$.job\", \"TimeoutSeconds\": 30,\r\n      \"Retry\": [{\"ErrorEquals\": [\"Glue.InternalServiceException\", \"Glue.OperationTimeoutException\"], \"IntervalSeconds\": 2, \"MaxAttempts\": 2, \"BackoffRate\": 2, \"JitterStrategy\": \"FULL\"}],\r\n      \"Catch\": [{\"ErrorEquals\": [\"States.ALL\"], \"ResultPath\": \"$.failure\", \"Next\": \"NotifyFailure\"}],\r\n      \"Next\": \"ValidateFrozenJob\"\r\n    },\r\n    \"ValidateFrozenJob\": {\r\n      \"Type\": \"Choice\", \"Choices\": [{\"And\": [\r\n        {\"Variable\": \"$.job.Job.GlueVersion\", \"IsPresent\": true},\r\n        {\"Variable\": \"$.job.Job.GlueVersion\", \"StringEquals\": \"5.0\"},\r\n        {\"Variable\": \"$.job.Job.Role\", \"IsPresent\": true},\r\n        {\"Variable\": \"$.job.Job.Role\", \"StringEquals\": \"arn:aws:iam::588738581042:role/is459-g3-glue-frozen-scoring\"},\r\n        {\"Variable\": \"$.job.Job.WorkerType\", \"IsPresent\": true},\r\n        {\"Variable\": \"$.job.Job.WorkerType\", \"StringEquals\": \"G.1X\"},\r\n        {\"Variable\": \"$.job.Job.NumberOfWorkers\", \"IsPresent\": true},\r\n        {\"Variable\": \"$.job.Job.NumberOfWorkers\", \"NumericEquals\": 2},\r\n        {\"Variable\": \"$.job.Job.Timeout\", \"IsPresent\": true},\r\n        {\"Variable\": \"$.job.Job.Timeout\", \"NumericEquals\": 10},\r\n        {\"Variable\": \"$.job.Job.MaxRetries\", \"IsPresent\": true},\r\n        {\"Variable\": \"$.job.Job.MaxRetries\", \"NumericEquals\": 0},\r\n        {\"Variable\": \"$.job.Job.ExecutionProperty.MaxConcurrentRuns\", \"IsPresent\": true},\r\n        {\"Variable\": \"$.job.Job.ExecutionProperty.MaxConcurrentRuns\", \"NumericEquals\": 1},\r\n        {\"Variable\": \"$.job.Job.Command.ScriptLocation\", \"IsPresent\": true},\r\n        {\"Variable\": \"$.job.Job.Command.ScriptLocation\", \"StringEquals\": \"s3://is459-g3-588738581042-ap-southeast-1/scoring-artifacts/frozen-localized-20261005/score_transactions.py\"},\r\n        {\"Variable\": \"$.job.Job.NonOverridableArguments['--INPUT']\", \"IsPresent\": true},\r\n        {\"Variable\": \"$.job.Job.NonOverridableArguments['--INPUT']\", \"StringEquals\": \"s3://is459-g3-588738581042-ap-southeast-1/curated/full-optimized-20261005/transactions/\"},\r\n        {\"Variable\": \"$.job.Job.NonOverridableArguments['--OUTPUT']\", \"IsPresent\": true},\r\n        {\"Variable\": \"$.job.Job.NonOverridableArguments['--OUTPUT']\", \"StringEquals\": \"s3://is459-g3-588738581042-ap-southeast-1/scored/full-orchestrated-20261006/transactions/\"},\r\n        {\"Variable\": \"$.job.Job.NonOverridableArguments['--EXPECTED_ROWS']\", \"IsPresent\": true},\r\n        {\"Variable\": \"$.job.Job.NonOverridableArguments['--EXPECTED_ROWS']\", \"StringEquals\": \"5078345\"},\r\n        {\"Variable\": \"$.job.Job.NonOverridableArguments['--MANIFEST_SHA256']\", \"IsPresent\": true},\r\n        {\"Variable\": \"$.job.Job.NonOverridableArguments['--MANIFEST_SHA256']\", \"StringEquals\": \"323a1eb1555f587d6553f09b9b0b90a9f49030460986df1faaf8b55ef3fc1b8f\"},\r\n        {\"Variable\": \"$.job.Job.NonOverridableArguments['--TempDir']\", \"IsPresent\": true},\r\n        {\"Variable\": \"$.job.Job.NonOverridableArguments['--TempDir']\", \"StringEquals\": \"s3://is459-g3-588738581042-ap-southeast-1/tmp/scoring/full-orchestrated-20261006/\"},\r\n        {\"Variable\": \"$.job.Job.NonOverridableArguments['--conf']\", \"IsPresent\": true},\r\n        {\"Variable\": \"$.job.Job.NonOverridableArguments['--conf']\", \"StringEquals\": \"spark.hadoop.mapreduce.fileoutputcommitter.marksuccessfuljobs=true\"}\r\n      ], \"Next\": \"GetCuratedTable\"}], \"Default\": \"ContractRejected\"\r\n    },\r\n    \"ContractRejected\": {\"Type\": \"Pass\", \"Result\": {\"Error\": \"FrozenJobOrSourceContractMismatch\", \"Cause\": \"No paid task started; re-review exact job/source settings.\"}, \"ResultPath\": \"$.failure\", \"Next\": \"NotifyFailure\"},\r\n    \"GetCuratedTable\": {\r\n      \"Type\": \"Task\", \"Resource\": \"arn:aws:states:::aws-sdk:glue:getTable\",\r\n      \"Parameters\": {\"DatabaseName\": \"is459_g3_curated\", \"Name\": \"full_transactions\"}, \"ResultPath\": \"$.table\", \"TimeoutSeconds\": 30,\r\n      \"Retry\": [{\"ErrorEquals\": [\"Glue.InternalServiceException\", \"Glue.OperationTimeoutException\"], \"IntervalSeconds\": 2, \"MaxAttempts\": 2, \"BackoffRate\": 2, \"JitterStrategy\": \"FULL\"}],\r\n      \"Catch\": [{\"ErrorEquals\": [\"States.ALL\"], \"ResultPath\": \"$.failure\", \"Next\": \"NotifyFailure\"}], \"Next\": \"ValidateCuratedTable\"\r\n    },\r\n    \"ValidateCuratedTable\": {\"Type\": \"Choice\", \"Choices\": [{\"And\": [\r\n      {\"Variable\": \"$.table.Table.StorageDescriptor.Location\", \"IsPresent\": true},\r\n      {\"Variable\": \"$.table.Table.StorageDescriptor.Location\", \"StringEquals\": \"s3://is459-g3-588738581042-ap-southeast-1/curated/full-optimized-20261005/transactions/\"},\r\n      {\"Variable\": \"$.table.Table.Parameters['projection.enabled']\", \"IsPresent\": true},\r\n      {\"Variable\": \"$.table.Table.Parameters['projection.enabled']\", \"StringEquals\": \"true\"},\r\n      {\"Variable\": \"$.table.Table.Parameters['storage.location.template']\", \"IsPresent\": true},\r\n      {\"Variable\": \"$.table.Table.Parameters['storage.location.template']\", \"StringEquals\": \"s3://is459-g3-588738581042-ap-southeast-1/curated/full-optimized-20261005/transactions/txn_date=${txn_date}/\"}\r\n    ], \"Next\": \"GetWorkgroup\"}], \"Default\": \"ContractRejected\"},\r\n    \"GetWorkgroup\": {\r\n      \"Type\": \"Task\", \"Resource\": \"arn:aws:states:::aws-sdk:athena:getWorkGroup\",\r\n      \"Parameters\": {\"WorkGroup\": \"is459-g3-analysis\"}, \"ResultPath\": \"$.workgroup\", \"TimeoutSeconds\": 30,\r\n      \"Retry\": [{\"ErrorEquals\": [\"Athena.InternalServerException\", \"Athena.TooManyRequestsException\"], \"IntervalSeconds\": 2, \"MaxAttempts\": 2, \"BackoffRate\": 2, \"JitterStrategy\": \"FULL\"}],\r\n      \"Catch\": [{\"ErrorEquals\": [\"States.ALL\"], \"ResultPath\": \"$.failure\", \"Next\": \"NotifyFailure\"}], \"Next\": \"ValidateWorkgroup\"\r\n    },\r\n    \"ValidateWorkgroup\": {\"Type\": \"Choice\", \"Choices\": [{\"And\": [\r\n      {\"Variable\": \"$.workgroup.WorkGroup.State\", \"IsPresent\": true},\r\n      {\"Variable\": \"$.workgroup.WorkGroup.State\", \"StringEquals\": \"ENABLED\"},\r\n      {\"Variable\": \"$.workgroup.WorkGroup.Configuration.EnforceWorkGroupConfiguration\", \"IsPresent\": true},\r\n      {\"Variable\": \"$.workgroup.WorkGroup.Configuration.EnforceWorkGroupConfiguration\", \"BooleanEquals\": true},\r\n      {\"Variable\": \"$.workgroup.WorkGroup.Configuration.BytesScannedCutoffPerQuery\", \"IsPresent\": true},\r\n      {\"Variable\": \"$.workgroup.WorkGroup.Configuration.BytesScannedCutoffPerQuery\", \"NumericEquals\": 1073741824},\r\n      {\"Variable\": \"$.workgroup.WorkGroup.Configuration.ResultConfiguration.OutputLocation\", \"IsPresent\": true},\r\n      {\"Variable\": \"$.workgroup.WorkGroup.Configuration.ResultConfiguration.OutputLocation\", \"StringEquals\": \"s3://is459-g3-588738581042-ap-southeast-1/athena-results/\"},\r\n      {\"Variable\": \"$.workgroup.WorkGroup.Configuration.ResultConfiguration.EncryptionConfiguration.EncryptionOption\", \"IsPresent\": true},\r\n      {\"Variable\": \"$.workgroup.WorkGroup.Configuration.ResultConfiguration.EncryptionConfiguration.EncryptionOption\", \"StringEquals\": \"SSE_S3\"}\r\n    ], \"Next\": \"CheckFreshOutput\"}], \"Default\": \"ContractRejected\"},\r\n    \"CheckFreshOutput\": {\r\n      \"Type\": \"Task\", \"Resource\": \"arn:aws:states:::aws-sdk:s3:listObjectsV2\",\r\n      \"Parameters\": {\"Bucket\": \"is459-g3-588738581042-ap-southeast-1\", \"Prefix\": \"scored/full-orchestrated-20261006/transactions\", \"MaxKeys\": 1}, \"ResultPath\": \"$.inventory\", \"TimeoutSeconds\": 30,\r\n      \"Retry\": [{\"ErrorEquals\": [\"S3.SlowDownException\", \"S3.InternalErrorException\"], \"IntervalSeconds\": 2, \"MaxAttempts\": 2, \"BackoffRate\": 2, \"JitterStrategy\": \"FULL\"}],\r\n      \"Catch\": [{\"ErrorEquals\": [\"States.ALL\"], \"ResultPath\": \"$.failure\", \"Next\": \"NotifyFailure\"}], \"Next\": \"OutputEmpty\"\r\n    },\r\n    \"OutputEmpty\": {\"Type\": \"Choice\", \"Choices\": [{\"And\": [{\"Variable\": \"$.inventory.KeyCount\", \"IsPresent\": true}, {\"Variable\": \"$.inventory.KeyCount\", \"NumericEquals\": 0}], \"Next\": \"CheckFreshTemp\"}], \"Default\": \"ExistingOutputRejected\"},\r\n    \"CheckFreshTemp\": {\r\n      \"Type\": \"Task\", \"Resource\": \"arn:aws:states:::aws-sdk:s3:listObjectsV2\",\r\n      \"Parameters\": {\"Bucket\": \"is459-g3-588738581042-ap-southeast-1\", \"Prefix\": \"tmp/scoring/full-orchestrated-20261006\", \"MaxKeys\": 1}, \"ResultPath\": \"$.temp_inventory\", \"TimeoutSeconds\": 30,\r\n      \"Retry\": [{\"ErrorEquals\": [\"S3.SlowDownException\", \"S3.InternalErrorException\"], \"IntervalSeconds\": 2, \"MaxAttempts\": 2, \"BackoffRate\": 2, \"JitterStrategy\": \"FULL\"}],\r\n      \"Catch\": [{\"ErrorEquals\": [\"States.ALL\"], \"ResultPath\": \"$.failure\", \"Next\": \"NotifyFailure\"}], \"Next\": \"TempEmpty\"\r\n    },\r\n    \"TempEmpty\": {\"Type\": \"Choice\", \"Choices\": [{\"And\": [{\"Variable\": \"$.temp_inventory.KeyCount\", \"IsPresent\": true}, {\"Variable\": \"$.temp_inventory.KeyCount\", \"NumericEquals\": 0}], \"Next\": \"ComputeBusinessOutputs\"}], \"Default\": \"ExistingOutputRejected\"},\r\n    \"ExistingOutputRejected\": {\"Type\": \"Pass\", \"Result\": {\"Error\": \"OutputAlreadyExists\", \"Cause\": \"No paid task started; preserve completed or partial output and use a newly reviewed run.\"}, \"ResultPath\": \"$.failure\", \"Next\": \"NotifyFailure\"},\r\n    \"ComputeBusinessOutputs\": {\r\n      \"Type\": \"Parallel\", \"InputPath\": \"$\", \"ResultPath\": \"$.business_outputs\",\r\n      \"Branches\": [\r\n        {\"StartAt\": \"RunFrozenScoring\", \"States\": {\r\n          \"RunFrozenScoring\": {\"Type\": \"Task\", \"Resource\": \"arn:aws:states:::glue:startJobRun.sync\",\r\n            \"Parameters\": {\"JobName\": \"is459-g3-score-frozen\"}, \"ResultPath\": \"$.score_run\", \"TimeoutSeconds\": 900, \"Next\": \"CheckRealSuccessMarker\"},\r\n          \"CheckRealSuccessMarker\": {\"Type\": \"Task\", \"Resource\": \"arn:aws:states:::aws-sdk:s3:headObject\",\r\n            \"Parameters\": {\"Bucket\": \"is459-g3-588738581042-ap-southeast-1\", \"Key\": \"scored/full-orchestrated-20261006/transactions/_SUCCESS\"}, \"ResultPath\": \"$.marker\", \"TimeoutSeconds\": 30,\r\n            \"Retry\": [{\"ErrorEquals\": [\"S3.SlowDownException\", \"S3.InternalErrorException\"], \"IntervalSeconds\": 2, \"MaxAttempts\": 2, \"BackoffRate\": 2, \"JitterStrategy\": \"FULL\"}], \"Next\": \"ValidateSuccessMarker\"},\r\n          \"ValidateSuccessMarker\": {\"Type\": \"Choice\", \"Choices\": [{\"And\": [\r\n            {\"Variable\": \"$.marker.ContentLength\", \"IsPresent\": true},\r\n            {\"Variable\": \"$.marker.ContentLength\", \"NumericEquals\": 0},\r\n            {\"Variable\": \"$.marker.ServerSideEncryption\", \"IsPresent\": true},\r\n            {\"Variable\": \"$.marker.ServerSideEncryption\", \"StringEquals\": \"AES256\"}\r\n          ], \"Next\": \"ScoringComplete\"}], \"Default\": \"InvalidMarker\"},\r\n          \"InvalidMarker\": {\"Type\": \"Fail\", \"Error\": \"InvalidScoringSuccessMarker\"},\r\n          \"ScoringComplete\": {\"Type\": \"Pass\", \"Parameters\": {\"job_run.$\": \"$.score_run\", \"success_marker_verified\": true}, \"End\": true}\r\n        }},\r\n        {\"StartAt\": \"RunTreasuryCorridors\", \"States\": {\r\n          \"RunTreasuryCorridors\": {\"Type\": \"Task\", \"Resource\": \"arn:aws:states:::athena:startQueryExecution.sync\",\r\n            \"Parameters\": {\"QueryString\": \"-- BQ2: directed volume and concentration, never an AML suspiciousness score.\\nWITH directed AS (\\n    SELECT 'bank' AS corridor_type, txn_date,\\n           from_bank AS from_node, to_bank AS to_node,\\n           count(*) AS transactions, sum(amount_usd) AS volume_usd\\n    FROM full_transactions\\n    WHERE txn_date BETWEEN '2022-09-01' AND '2022-09-18'\\n    GROUP BY txn_date, from_bank, to_bank\\n    UNION ALL\\n    SELECT 'currency' AS corridor_type, txn_date,\\n           payment_currency AS from_node, receiving_currency AS to_node,\\n           count(*) AS transactions, sum(amount_usd) AS volume_usd\\n    FROM full_transactions\\n    WHERE txn_date BETWEEN '2022-09-01' AND '2022-09-18'\\n    GROUP BY txn_date, payment_currency, receiving_currency\\n), shares AS (\\n    SELECT *, volume_usd / nullif(\\n        sum(volume_usd) OVER (PARTITION BY corridor_type, txn_date), 0\\n    ) AS volume_share\\n    FROM directed\\n)\\nSELECT *, sum(volume_share * volume_share) OVER (\\n    PARTITION BY corridor_type, txn_date\\n) AS daily_hhi\\nFROM shares\\nORDER BY corridor_type, txn_date, volume_usd DESC, from_node, to_node;\\n\", \"WorkGroup\": \"is459-g3-analysis\", \"QueryExecutionContext\": {\"Database\": \"is459_g3_curated\"},\r\n              \"ClientRequestToken.$\": \"States.Hash(States.Format('{}:treasury-corridors', $$.Execution.Id), 'SHA-256')\"},\r\n            \"TimeoutSeconds\": 300, \"End\": true}\r\n        }}\r\n      ],\r\n      \"Catch\": [{\"ErrorEquals\": [\"States.ALL\"], \"ResultPath\": \"$.failure\", \"Next\": \"NotifyFailure\"}],\r\n      \"Next\": \"BusinessOutputsReady\"\r\n    },\r\n    \"BusinessOutputsReady\": {\"Type\": \"Pass\", \"Parameters\": {\r\n      \"status\": \"business-outputs-ready-reconciliation-required\", \"run_id\": \"full-orchestrated-20261006\", \"expected_rows\": 5078345,\r\n      \"execution_arn.$\": \"$$.Execution.Id\", \"scored_uri\": \"s3://is459-g3-588738581042-ap-southeast-1/scored/full-orchestrated-20261006/transactions/\",\r\n      \"business_outputs.$\": \"$.business_outputs\", \"dashboard_published\": false,\r\n      \"next_step\": \"Verify every score/feature and treasury result locally; prepare a new release before separately approved publication.\"\r\n    }, \"End\": true},\r\n    \"NotifyFailure\": {\r\n      \"Type\": \"Task\", \"Resource\": \"arn:aws:states:::sns:publish\",\r\n      \"Parameters\": {\"TopicArn\": \"arn:aws:sns:ap-southeast-1:588738581042:is459-g3-failures\", \"Subject\": \"IS459 reviewed batch failed\",\r\n        \"Message.$\": \"States.JsonToString($.failure)\"}, \"ResultPath\": null, \"TimeoutSeconds\": 30,\r\n      \"Retry\": [{\"ErrorEquals\": [\"SNS.InternalError\", \"SNS.Throttled\"], \"IntervalSeconds\": 2, \"MaxAttempts\": 2, \"BackoffRate\": 2, \"JitterStrategy\": \"FULL\"}],\r\n      \"Catch\": [{\"ErrorEquals\": [\"States.ALL\"], \"ResultPath\": \"$.notification_failure\", \"Next\": \"WorkflowFailed\"}], \"Next\": \"WorkflowFailed\"\r\n    },\r\n    \"WorkflowFailed\": {\"Type\": \"Fail\", \"Error\": \"ReviewedBatchFailed\", \"Cause\": \"Inspect execution history and preserved output; no automatic compute rerun or publication.\"}\r\n  }\r\n}\r\n",
