  "outputs": {
    "definition": {
      "value": {
        "Comment": "Frozen BQ1 scoring and BQ2 corridor query. Completion requires local reconciliation before any publication.",
        "StartAt": "ValidateRequest",
        "States": {
          "BusinessOutputsReady": {
            "End": true,
            "Parameters": {
              "business_outputs.$": "$.business_outputs",
              "dashboard_published": false,
              "execution_arn.$": "$$.Execution.Id",
              "expected_rows": 5078345,
              "next_step": "Verify every score/feature and treasury result locally; prepare a new release before separately approved publication.",
              "run_id": "full-orchestrated-20261006",
              "scored_uri": "s3://is459-g3-588738581042-ap-southeast-1/scored/full-orchestrated-20261006/transactions/",
              "status": "business-outputs-ready-reconciliation-required"
            },
            "Type": "Pass"
          },
          "CheckFreshOutput": {
