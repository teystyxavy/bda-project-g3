              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "Next": "NotifyFailure",
                "ResultPath": "$.failure"
              }
            ],
            "Next": "TempEmpty",
            "Parameters": {
              "Bucket": "is459-g3-588738581042-ap-southeast-1",
              "MaxKeys": 1,
              "Prefix": "tmp/scoring/full-orchestrated-20261006"
            },
            "Resource": "arn:aws:states:::aws-sdk:s3:listObjectsV2",
            "ResultPath": "$.temp_inventory",
            "Retry": [
              {
                "BackoffRate": 2,
                "ErrorEquals": [
                  "S3.SlowDownException",
                  "S3.InternalErrorException"
                ],
                "IntervalSeconds": 2,
                "JitterStrategy": "FULL",
                "MaxAttempts": 2
              }
            ],
            "TimeoutSeconds": 30,
            "Type": "Task"
          },
          "ComputeBusinessOutputs": {
            "Branches": [
              {
                "StartAt": "RunFrozenScoring",
                "States": {
                  "CheckRealSuccessMarker": {
                    "Next": "ValidateSuccessMarker",
                    "Parameters": {
                      "Bucket": "is459-g3-588738581042-ap-southeast-1",
                      "Key": "scored/full-orchestrated-20261006/transactions/_SUCCESS"
                    },
                    "Resource": "arn:aws:states:::aws-sdk:s3:headObject",
                    "ResultPath": "$.marker",
                    "Retry": [
                      {
                        "BackoffRate": 2,
                        "ErrorEquals": [
                          "S3.SlowDownException",
                          "S3.InternalErrorException"
                        ],
                        "IntervalSeconds": 2,
                        "JitterStrategy": "FULL",
                        "MaxAttempts": 2
                      }
                    ],
                    "TimeoutSeconds": 30,
                    "Type": "Task"
                  },
                  "InvalidMarker": {
                    "Error": "InvalidScoringSuccessMarker",
                    "Type": "Fail"
                  },
                  "RunFrozenScoring": {
                    "Next": "CheckRealSuccessMarker",
                    "Parameters": {
                      "JobName": "is459-g3-score-frozen"
                    },
                    "Resource": "arn:aws:states:::glue:startJobRun.sync",
                    "ResultPath": "$.score_run",
                    "TimeoutSeconds": 900,
                    "Type": "Task"
                  },
                  "ScoringComplete": {
                    "End": true,
                    "Parameters": {
                      "job_run.$": "$.score_run",
                      "success_marker_verified": true
                    },
                    "Type": "Pass"
                  },
                  "ValidateSuccessMarker": {
                    "Choices": [
                      {
                        "And": [
                          {
                            "IsPresent": true,
                            "Variable": "$.marker.ContentLength"
                          },
                          {
                            "NumericEquals": 0,
                            "Variable": "$.marker.ContentLength"
                          },
                          {
                            "IsPresent": true,
                            "Variable": "$.marker.ServerSideEncryption"
                          },
                          {
                            "StringEquals": "AES256",
                            "Variable": "$.marker.ServerSideEncryption"
                          }
                        ],
                        "Next": "ScoringComplete"
                      }
                    ],
                    "Default": "InvalidMarker",
                    "Type": "Choice"
                  }
                }
              },
              {
                "StartAt": "RunTreasuryCorridors",
                "States": {
                  "RunTreasuryCorridors": {
                    "End": true,
                    "Parameters": {
                      "ClientRequestToken.$": "States.Hash(States.Format('{}:treasury-corridors', $$.Execution.Id), 'SHA-256')",
                      "QueryExecutionContext": {
                        "Database": "is459_g3_curated"
                      },
                      "QueryString": "-- BQ2: directed volume and concentration, never an AML suspiciousness score.\nWITH directed AS (\n    SELECT 'bank' AS corridor_type, txn_date,\n           from_bank AS from_node, to_bank AS to_node,\n           count(*) AS transactions, sum(amount_usd) AS volume_usd\n    FROM full_transactions\n    WHERE txn_date BETWEEN '2022-09-01' AND '2022-09-18'\n    GROUP BY txn_date, from_bank, to_bank\n    UNION ALL\n    SELECT 'currency' AS corridor_type, txn_date,\n           payment_currency AS from_node, receiving_currency AS to_node,\n           count(*) AS transactions, sum(amount_usd) AS volume_usd\n    FROM full_transactions\n    WHERE txn_date BETWEEN '2022-09-01' AND '2022-09-18'\n    GROUP BY txn_date, payment_currency, receiving_currency\n), shares AS (\n    SELECT *, volume_usd / nullif(\n        sum(volume_usd) OVER (PARTITION BY corridor_type, txn_date), 0\n    ) AS volume_share\n    FROM directed\n)\nSELECT *, sum(volume_share * volume_share) OVER (\n    PARTITION BY corridor_type, txn_date\n) AS daily_hhi\nFROM shares\nORDER BY corridor_type, txn_date, volume_usd DESC, from_node, to_node;\n",
                      "WorkGroup": "is459-g3-analysis"
                    },
                    "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
                    "TimeoutSeconds": 300,
                    "Type": "Task"
                  }
                }
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "Next": "NotifyFailure",
                "ResultPath": "$.failure"
              }
            ],
