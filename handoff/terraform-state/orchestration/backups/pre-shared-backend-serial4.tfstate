            "name": "terraform-f7d9bf6e68667a48959beb8d65",
            "name_prefix": "terraform-",
            "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Action\":[\"glue:GetJob\",\"glue:StartJobRun\",\"glue:GetJobRun\",\"glue:GetJobRuns\",\"glue:BatchStopJobRun\"],\"Effect\":\"Allow\",\"Resource\":[\"arn:aws:glue:ap-southeast-1:588738581042:job/is459-g3-score-frozen\"],\"Sid\":\"OnlyFrozenJob\"},{\"Action\":[\"glue:GetTable\",\"glue:GetDatabase\",\"glue:GetPartitions\"],\"Effect\":\"Allow\",\"Resource\":[\"arn:aws:glue:ap-southeast-1:588738581042:catalog\",\"arn:aws:glue:ap-southeast-1:588738581042:database/is459_g3_curated\",\"arn:aws:glue:ap-southeast-1:588738581042:table/is459_g3_curated/full_transactions\"],\"Sid\":\"ReadVerifiedCatalog\"},{\"Action\":[\"athena:GetWorkGroup\",\"athena:StartQueryExecution\",\"athena:GetQueryExecution\",\"athena:GetQueryResults\",\"athena:StopQueryExecution\"],\"Effect\":\"Allow\",\"Resource\":[\"arn:aws:athena:ap-southeast-1:588738581042:workgroup/is459-g3-analysis\"],\"Sid\":\"OnlyBudgetedWorkgroup\"},{\"Action\":[\"athena:GetDataCatalog\"],\"Effect\":\"Allow\",\"Resource\":[\"arn:aws:athena:ap-southeast-1:588738581042:datacatalog/AwsDataCatalog\"],\"Sid\":\"ReadDefaultAthenaCatalog\"},{\"Action\":[\"s3:GetBucketLocation\"],\"Effect\":\"Allow\",\"Resource\":[\"arn:aws:s3:::is459-g3-588738581042-ap-southeast-1\"],\"Sid\":\"BucketLocation\"},{\"Action\":[\"s3:ListBucket\"],\"Condition\":{\"StringLike\":{\"s3:prefix\":[\"curated/full-optimized-20261005/transactions\",\"curated/full-optimized-20261005/transactions/\",\"curated/full-optimized-20261005/transactions/*\",\"scored/full-orchestrated-20261006/transactions\",\"scored/full-orchestrated-20261006/transactions/\",\"scored/full-orchestrated-20261006/transactions/*\",\"tmp/scoring/full-orchestrated-20261006\",\"tmp/scoring/full-orchestrated-20261006/\",\"tmp/scoring/full-orchestrated-20261006/*\",\"athena-results\",\"athena-results/\",\"athena-results/*\"]}},\"Effect\":\"Allow\",\"Resource\":[\"arn:aws:s3:::is459-g3-588738581042-ap-southeast-1\"],\"Sid\":\"ListOnlyReviewedPrefixes\"},{\"Action\":[\"s3:GetObject\"],\"Effect\":\"Allow\",\"Resource\":[\"arn:aws:s3:::is459-g3-588738581042-ap-southeast-1/curated/full-optimized-20261005/transactions/*\",\"arn:aws:s3:::is459-g3-588738581042-ap-southeast-1/athena-results/*\",\"arn:aws:s3:::is459-g3-588738581042-ap-southeast-1/scored/full-orchestrated-20261006/transactions/_SUCCESS\"],\"Sid\":\"ReadCuratedAndQueryResults\"},{\"Action\":[\"s3:PutObject\",\"s3:AbortMultipartUpload\",\"s3:ListMultipartUploadParts\"],\"Effect\":\"Allow\",\"Resource\":[\"arn:aws:s3:::is459-g3-588738581042-ap-southeast-1/athena-results/*\"],\"Sid\":\"WriteOnlyAthenaResults\"},{\"Action\":[\"sns:Publish\"],\"Effect\":\"Allow\",\"Resource\":[\"arn:aws:sns:ap-southeast-1:588738581042:is459-g3-failures\"],\"Sid\":\"NotifyExistingFailureTopic\"}]}",
