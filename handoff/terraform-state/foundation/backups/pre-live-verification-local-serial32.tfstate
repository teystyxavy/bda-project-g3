  "resources": [
    {
      "mode": "managed",
      "type": "aws_athena_named_query",
      "name": "corridors",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "database": "is459_g3_curated",
            "description": "",
            "id": "4c62f730-3e63-4a60-80cd-d808aa7ca303",
            "name": "is459-g3-smoke-corridors",
            "query": "WITH corridors AS (\n    SELECT txn_date, from_bank, to_bank, count(*) AS transactions,\n           sum(amount_usd) AS volume_usd\n    FROM smoke_transactions\n    GROUP BY txn_date, from_bank, to_bank\n), shares AS (\n    SELECT *, volume_usd / nullif(sum(volume_usd) OVER (PARTITION BY txn_date), 0) AS volume_share\n    FROM corridors\n)\nSELECT *, sum(volume_share * volume_share) OVER (PARTITION BY txn_date) AS daily_hhi\nFROM shares\nORDER BY txn_date, volume_usd DESC;\n",
            "region": "ap-southeast-1",
            "workgroup": "is459-g3-analysis"
          },
          "sensitive_attributes": [],
          "private": "bnVsbA==",
          "dependencies": [
            "aws_athena_workgroup.analysis",
            "aws_glue_catalog_database.curated",
            "aws_s3_bucket.pipeline"
          ]
        }
      ]
    },
    {
      "mode": "managed",
      "type": "aws_athena_named_query",
      "name": "reconcile",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "database": "is459_g3_curated",
            "description": "",
            "id": "7e5ede8d-4b98-4674-91fe-4abfbe01a077",
            "name": "is459-g3-smoke-reconciliation",
            "query": "SELECT count(*) AS transactions,\n       sum(amount_usd) AS amount_usd,\n       sum(amount_usd_asof) AS amount_usd_asof,\n       sum(is_laundering) AS positives,\n       count_if(from_entity_id IS NULL OR to_entity_id IS NULL) AS missing_accounts,\n       count_if(amount_usd IS NULL OR amount_usd_asof IS NULL) AS missing_fx\nFROM smoke_transactions;\n",
            "region": "ap-southeast-1",
            "workgroup": "is459-g3-analysis"
          },
          "sensitive_attributes": [],
          "private": "bnVsbA==",
          "dependencies": [
            "aws_athena_workgroup.analysis",
            "aws_glue_catalog_database.curated",
            "aws_s3_bucket.pipeline"
          ]
        }
      ]
    },
