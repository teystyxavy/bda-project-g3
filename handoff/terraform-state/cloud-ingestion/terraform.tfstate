    {
      "mode": "managed",
      "type": "aws_sfn_state_machine",
      "name": "cloud_ingest",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:states:ap-southeast-1:588738581042:stateMachine:is459-g3-cloud-ingest",
            "creation_date": "2026-10-06T08:14:20Z",
            "definition": "{\r\n  \"Comment\": \"Cloud acquisition followed by the existing verified batch workflow; no compute retries.\",\r\n  \"StartAt\": \"Acquire\",\r\n  \"TimeoutSeconds\": 8100,\r\n  \"States\": {\r\n    \"Acquire\": {\r\n      \"Type\": \"Task\",\r\n      \"Resource\": \"arn:aws:lambda:ap-southeast-1:588738581042:function:is459-g3-acquire\",\r\n      \"ResultPath\": \"$.acquisition\",\r\n      \"Next\": \"Cached\",\r\n      \"Catch\": [\r\n        {\r\n          \"ErrorEquals\": [\r\n            \"States.ALL\"\r\n          ],\r\n          \"ResultPath\": \"$.failure\",\r\n          \"Next\": \"NotifyFailure\"\r\n        }\r\n      ]\r\n    },\r\n    \"Cached\": {\r\n      \"Type\": \"Choice\",\r\n      \"Choices\": [\r\n        {\r\n          \"Variable\": \"$.acquisition.cache_hit\",\r\n          \"BooleanEquals\": true,\r\n          \"Next\": \"ExistingRelease\"\r\n        }\r\n      ],\r\n      \"Default\": \"Batch\"\r\n    },\r\n    \"ExistingRelease\": {\r\n      \"Type\": \"Pass\",\r\n      \"OutputPath\": \"$.acquisition.result\",\r\n      \"End\": true\r\n    },\r\n    \"Batch\": {\r\n      \"Type\": \"Task\",\r\n      \"Resource\": \"arn:aws:states:::states:startExecution.sync:2\",\r\n      \"Parameters\": {\r\n        \"StateMachineArn\": \"arn:aws:states:ap-southeast-1:588738581042:stateMachine:is459-g3-ingest\",\r\n        \"Name.$\": \"$.run_id\",\r\n        \"Input\": {\r\n          \"run_id.$\": \"$.run_id\",\r\n          \"AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID.$\": \"$$.Execution.Id\"\r\n        }\r\n      },\r\n      \"ResultPath\": \"$.batch\",\r\n      \"Next\": \"Published\",\r\n      \"Catch\": [\r\n        {\r\n          \"ErrorEquals\": [\r\n            \"States.ALL\"\r\n          ],\r\n          \"ResultPath\": \"$.failure\",\r\n          \"Next\": \"Failed\"\r\n        }\r\n      ]\r\n    },\r\n    \"Published\": {\r\n      \"Type\": \"Pass\",\r\n      \"OutputPath\": \"$.batch.Output\",\r\n      \"End\": true\r\n    },\r\n    \"NotifyFailure\": {\r\n      \"Type\": \"Task\",\r\n      \"Resource\": \"arn:aws:states:::sns:publish\",\r\n      \"Parameters\": {\r\n        \"TopicArn\": \"arn:aws:sns:ap-southeast-1:588738581042:is459-g3-failures\",\r\n        \"Message.$\": \"States.JsonToString($.failure)\"\r\n      },\r\n      \"ResultPath\": null,\r\n      \"Next\": \"Failed\",\r\n      \"Catch\": [\r\n        {\r\n          \"ErrorEquals\": [\r\n            \"States.ALL\"\r\n          ],\r\n          \"ResultPath\": null,\r\n          \"Next\": \"Failed\"\r\n        }\r\n      ]\r\n    },\r\n    \"Failed\": {\r\n      \"Type\": \"Fail\",\r\n      \"Error\": \"CloudIngestFailed\",\r\n      \"Cause\": \"Inspect acquisition or batch evidence; no automatic rerun.\"\r\n    }\r\n  }\r\n}\r\n",
            "description": "",
            "encryption_configuration": [
              {
                "kms_data_key_reuse_period_seconds": 0,
                "kms_key_id": "",
                "type": "AWS_OWNED_KEY"
              }
            ],
            "id": "arn:aws:states:ap-southeast-1:588738581042:stateMachine:is459-g3-cloud-ingest",
            "logging_configuration": [
              {
                "include_execution_data": false,
