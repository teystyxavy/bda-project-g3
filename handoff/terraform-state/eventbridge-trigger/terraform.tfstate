    {
      "mode": "managed",
      "type": "aws_sfn_state_machine",
      "name": "raw_trigger",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:states:ap-southeast-1:588738581042:stateMachine:is459-g3-raw-trigger",
            "creation_date": "2026-10-06T16:13:21Z",
            "definition": "{\n  \"Comment\": \"S3 upload trigger: start the existing verified batch once per run ID; no compute retries.\",\n  \"StartAt\": \"ParseKey\",\n  \"TimeoutSeconds\": 300,\n  \"States\": {\n    \"ParseKey\": {\n      \"Type\": \"Pass\",\n      \"Parameters\": {\n        \"key.$\": \"$.detail.object.key\",\n        \"run_id.$\": \"States.ArrayGetItem(States.StringSplit($.detail.object.key, '/'), 2)\"\n      },\n      \"ResultPath\": \"$.trigger\",\n      \"Next\": \"ExpectedKey\"\n    },\n    \"ExpectedKey\": {\n      \"Type\": \"Pass\",\n      \"Parameters\": {\n        \"key.$\": \"States.Format('pipeline/runs/{}/raw/trigger.json', $.trigger.run_id)\"\n      },\n      \"ResultPath\": \"$.expected\",\n      \"Next\": \"ValidKey\"\n    },\n    \"ValidKey\": {\n      \"Type\": \"Choice\",\n      \"Choices\": [\n        {\n          \"Variable\": \"$.trigger.key\",\n          \"StringEqualsPath\": \"$.expected.key\",\n          \"Next\": \"StartBatch\"\n        }\n      ],\n      \"Default\": \"Rejected\"\n    },\n    \"StartBatch\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::states:startExecution\",\n      \"Parameters\": {\n        \"StateMachineArn\": \"arn:aws:states:ap-southeast-1:588738581042:stateMachine:is459-g3-ingest\",\n        \"Name.$\": \"$.trigger.run_id\",\n        \"Input\": {\n          \"run_id.$\": \"$.trigger.run_id\",\n          \"AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID.$\": \"$$.Execution.Id\"\n        }\n      },\n      \"ResultPath\": \"$.batch\",\n      \"Next\": \"Started\",\n      \"Catch\": [\n        {\n          \"ErrorEquals\": [\n            \"StepFunctions.ExecutionAlreadyExistsException\"\n          ],\n          \"ResultPath\": \"$.failure\",\n          \"Next\": \"AlreadyStarted\"\n        },\n        {\n          \"ErrorEquals\": [\n            \"States.ALL\"\n          ],\n          \"ResultPath\": \"$.failure\",\n          \"Next\": \"NotifyFailure\"\n        }\n      ]\n    },\n    \"Started\": {\n      \"Type\": \"Pass\",\n      \"Parameters\": {\n        \"run_id.$\": \"$.trigger.run_id\",\n        \"execution_arn.$\": \"$.batch.ExecutionArn\"\n      },\n      \"End\": true\n    },\n    \"AlreadyStarted\": {\n      \"Type\": \"Succeed\",\n      \"Comment\": \"The run ID already has a batch execution; nothing is repeated.\"\n    },\n    \"Rejected\": {\n      \"Type\": \"Fail\",\n      \"Error\": \"UnexpectedTriggerKey\",\n      \"Cause\": \"Only pipeline/runs/\u003crun\u003e/raw/trigger.json starts a run.\"\n    },\n    \"NotifyFailure\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::sns:publish\",\n      \"Parameters\": {\n        \"TopicArn\": \"arn:aws:sns:ap-southeast-1:588738581042:is459-g3-failures\",\n        \"Message.$\": \"States.JsonToString($.failure)\"\n      },\n      \"ResultPath\": null,\n      \"Next\": \"Failed\",\n      \"Catch\": [\n        {\n          \"ErrorEquals\": [\n            \"States.ALL\"\n          ],\n          \"ResultPath\": null,\n          \"Next\": \"Failed\"\n        }\n      ]\n    },\n    \"Failed\": {\n      \"Type\": \"Fail\",\n      \"Error\": \"RawTriggerFailed\",\n      \"Cause\": \"The batch did not start; inspect the run's raw upload. No automatic rerun.\"\n    }\n  }\n}\n",
            "description": "",
            "encryption_configuration": [
              {
                "kms_data_key_reuse_period_seconds": 0,
                "kms_key_id": "",
                "type": "AWS_OWNED_KEY"
              }
            ],
            "id": "arn:aws:states:ap-southeast-1:588738581042:stateMachine:is459-g3-raw-trigger",
            "logging_configuration": [
