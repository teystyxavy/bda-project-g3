# =============================================================================
# infra/ingestion/main.tf -- the main end-to-end batch pipeline (is459-g3-ingest)
# =============================================================================
# What it is: the production-style workflow that turns one uploaded run of raw
# data into a published dashboard release. For a run <run_id>, everything lives
# under s3://<bucket>/pipeline/runs/<run_id>/ (raw/, curated/, scored/,
# baseline/, export/, evidence/). The Step Functions state machine
# is459-g3-ingest (definition generated by build-workflow.py into
# workflow.asl.json) does:
#   Begin      control Lambda validates the raw upload against manifest.json,
#              takes the single pipeline lock (pipeline/lock.json) and checks
#              the stage caches;
#   Curate     Glue job is459-g3-ingest-curate: CSV + FX -> curated Parquet
#              (skipped on a curated cache hit);
#   Prepare    control Lambda registers the run's Athena table run_<id> (for
#              ad hoc analyst queries only; the pipeline itself no longer
#              reads through it);
#   Parallel   (a) Glue "baseline" verification + optional
#              SageMaker training of a candidate model, (b) Glue job
#              is459-g3-ingest-score (frozen model risk scores, BQ1, skipped on
#              a cache hit), (c) Glue job is459-g3-ingest-network (mule-network
#              detection, BQ2; always reruns);
#   Export     Glue "export" builds the dashboard release;
#   Publish    control Lambda verifies hashes/contents and copies the release
#              to the dashboard bucket (infra/hosting), updates current.json,
#              invalidates CloudFront and releases the lock.
# Failures are recorded as evidence, the shared SNS topic is notified, and an
# EventBridge rule asks the control Lambda to stop any still-running workers.
#
# This file also uploads the deployment artefacts (scripts, packages, model)
# and the runtime config pipeline/deployment.json. Prepared by
# scripts/aws/prepare-ingestion.py and applied by scripts/aws/
# deploy-ingestion.ps1 / update-ingestion.ps1.
#
# -----------------------------------------------------------------------------
# variable "artifact_directory": local folder holding the prepared artefacts
# (control.zip, bda_pipeline.zip, wheels, job scripts, model/ files).
# variable "model_file": file name of the frozen XGBoost model inside model/.

variable "artifact_directory" { type = string }
variable "model_file" { type = string }
# variable "export_deployment": optional pinned export runtime for the export
# job only. null (default) = the export job runs this deployment's own
# pipeline_stage.py, bda_pipeline.zip and dashboard shell like baseline does.
# When set, the export job runs <prefix>/pipeline_stage.py with
# <prefix>/bda_pipeline.zip and <prefix>/dashboard/{index.html,dashboard.js,
# dashboard.css}, all uploaded beforehand to a content-addressed
# pipeline/deployments/export-improved-<zip sha256> prefix (uploaded out of
# band; Terraform does not upload them; set via
# scripts/aws/prepare-ingestion.py --export-deployment). It
# also enables S3 network checkpoints (tmp/ingest/export-checkpoints/) and the
# oversized-component review on the canonical export. Wheels, model inputs and
# deployment.json still come from pipeline_config, so run identity is unchanged.
variable "export_deployment" {
  type = object({ prefix = string, network_checkpoints = optional(bool, true),
  oversized_component_review = optional(bool, true), checkpoint_read_only = optional(bool, false) })
  default = null
  validation {
    condition     = var.export_deployment == null ? true : can(regex("^pipeline/deployments/export-improved-[0-9a-f]{64}$", var.export_deployment.prefix))
    error_message = "Pin the export runtime to a content-addressed pipeline/deployments/export-improved-<sha256> prefix."
  }
  validation {
    # glue_compute.run_stage rejects component review without checkpoints.
    condition     = var.export_deployment == null ? true : (!var.export_deployment.oversized_component_review || var.export_deployment.network_checkpoints)
    error_message = "Oversized-component review requires network checkpoints."
  }
}
# variable "pipeline_config": runtime configuration written to
# pipeline/deployment.json and to the control Lambda's environment: artefact
# and model S3 prefixes, model manifest hash, the digest-pinned SageMaker image
# (used only for training), CloudFront distribution
# id, dashboard URL and optional per-stage versions (used for cache keys).
# Validation: the image must be this project's ECR image pinned by digest, and
# the JSON must stay under 3,500 characters (it is passed as a Lambda env var).
variable "pipeline_config" {
  type = object({ schema_version = number, artifact_prefix = string, model_prefix = string,
    model_manifest_sha256 = string, image_uri = string,
  distribution_id = string, dashboard_url = string, stage_versions = optional(map(string), {}) })
  validation {
    condition     = can(regex("^588738581042\\.dkr\\.ecr\\.ap-southeast-1\\.amazonaws\\.com/is459-g3-training@sha256:[0-9a-f]{64}$", var.pipeline_config.image_uri)) && length(jsonencode(var.pipeline_config)) < 3500
    error_message = "Use a digest-pinned Group 3 image and a bounded configuration."
  }
}
# Fixed names/ARNs reused by the IAM policies:
#   s3 / site -- data-lake bucket and dashboard bucket ARNs;
#   machine   -- this workflow; jobs -- the four Glue jobs;
#   training -- ARN pattern of optional SageMaker training jobs;
#   catalog   -- Glue catalog, the is459_g3_ingest database and run_* tables;
#   files     -- every artefact file uploaded below (the model files go under
#                model/);
#   ecr       -- the training image repository;
#   failure_topic -- the shared SNS alert topic.
locals {
  account       = "588738581042"
  region        = "ap-southeast-1"
  bucket        = "is459-g3-${local.account}-${local.region}"
  s3            = "arn:aws:s3:::${local.bucket}"
  site          = "arn:aws:s3:::is459-g3-dashboard-${local.account}-${local.region}"
  arn           = "arn:aws"
  machine       = "arn:aws:states:${local.region}:${local.account}:stateMachine:is459-g3-ingest"
  jobs          = [for name in ["curate", "score", "baseline", "export", "network"] : "arn:aws:glue:${local.region}:${local.account}:job/is459-g3-ingest-${name}"]
  training      = "arn:aws:sagemaker:${local.region}:${local.account}:training-job/is459-g3-train-*"
  catalog       = ["arn:aws:glue:${local.region}:${local.account}:catalog", "arn:aws:glue:${local.region}:${local.account}:database/is459_g3_ingest", "arn:aws:glue:${local.region}:${local.account}:table/is459_g3_ingest/run_*"]
  files         = toset(concat(["control.zip", "bda_pipeline.zip", "runtime.gluewheels.zip", "curate_transactions.py", "score_transactions.py", "pipeline_stage.py", "network_mules.py", "dashboard/index.html", "dashboard/dashboard.js", "dashboard/dashboard.css"], [for name in ["comparison.json", "selection.json", "features.json", "model-manifest.json", "deployment.json", var.model_file] : "model/${name}"]))
  ecr           = "arn:aws:ecr:${local.region}:${local.account}:repository/is459-g3-training"
  failure_topic = "arn:aws:sns:${local.region}:${local.account}:is459-g3-failures"
  # Where each reference stage's script, package and dashboard shell live.
  stage_prefix = {
    baseline = var.pipeline_config.artifact_prefix
    export   = var.export_deployment == null ? var.pipeline_config.artifact_prefix : var.export_deployment.prefix
  }
  # Export-only switches read by jobs/pipeline_stage.py (absent = disabled).
  export_arguments = var.export_deployment == null ? {} : {
    "--NETWORK_CHECKPOINTS"        = tostring(var.export_deployment.network_checkpoints)
    "--OVERSIZED_COMPONENT_REVIEW" = tostring(var.export_deployment.oversized_component_review)
    "--CHECKPOINT_READ_ONLY"       = tostring(var.export_deployment.checkpoint_read_only)
  }
}
# `removed` block (Terraform 1.7+): an older version of this stack managed the
# uploads as aws_s3_object.artifact. This forgets that resource from state
# WITHOUT deleting the objects (destroy = false), so earlier artefacts stay in
# S3 for provenance and recovery.
removed {
  from = aws_s3_object.artifact
  lifecycle { destroy = false }
}
# Retain the predecessor's immutable deployment prefix for provenance/recovery.
# Upload each deployment artefact to <artifact_prefix>/<file>. source_hash
# (SHA-256 of the local file) makes Terraform re-upload when a file changes.
resource "aws_s3_object" "deployment_artifact" {
  for_each               = local.files
  bucket                 = local.bucket
  key                    = "${var.pipeline_config.artifact_prefix}/${each.value}"
  source                 = "${var.artifact_directory}/${each.value}"
  source_hash            = filesha256("${var.artifact_directory}/${each.value}")
  server_side_encryption = "AES256"
}
# The runtime configuration document read by the control Lambda, the cloud
# acquisition Lambda and the launcher scripts.
resource "aws_s3_object" "configuration" {
  bucket                 = local.bucket
  key                    = "pipeline/deployment.json"
  content                = jsonencode(var.pipeline_config)
  content_type           = "application/json"
  server_side_encryption = "AES256"
}
# Glue database for per-run Athena tables (run_<run_id>), which the control
# Lambda creates at runtime so each run's curated data can be queried alone.
resource "aws_glue_catalog_database" "runs" { name = "is459_g3_ingest" }
# Role for the ingestion Glue jobs; trusted only for Glue acting on these
# jobs in this account.
resource "aws_iam_role" "glue" {
  name               = "is459-g3-ingest-glue"
  assume_role_policy = jsonencode({ Version = "2012-10-17", Statement = [{ Effect = "Allow", Principal = { Service = "glue.amazonaws.com" }, Action = "sts:AssumeRole", Condition = { StringEquals = { "aws:SourceAccount" = local.account }, ArnLike = { "aws:SourceArn" = local.jobs } } }] })
}
# Glue job permissions:
resource "aws_iam_role_policy" "glue" {
  role = aws_iam_role.glue.id
  policy = jsonencode({ Version = "2012-10-17", Statement = [
    # - bucket region lookup;
    # - list/read only pipeline/* (inputs, artefacts) and tmp/ingest/* (scratch);
    # - write/delete only a run's curated/ and scored/ output and scratch space
    #   (delete and multipart actions are needed by Spark's output committer);
    # - the exact "<folder>_$folder$" marker keys EMRFS probes when committing a
    #   directory (kept to these names instead of opening up whole prefixes);
    # - create/write the job log groups; publish Glue job metrics.
    { Effect = "Allow", Action = ["s3:GetBucketLocation"], Resource = local.s3 },
    { Effect = "Allow", Action = ["s3:ListBucket"], Resource = local.s3, Condition = { StringLike = { "s3:prefix" = ["pipeline/*", "tmp/ingest/*", "sagemaker/outputs/is459-g3-train-*/*"] } } },
    { Effect = "Allow", Action = ["s3:GetObject"], Resource = ["${local.s3}/pipeline/*", "${local.s3}/tmp/ingest/*", "${local.s3}/sagemaker/outputs/is459-g3-train-*/*"] },
    { Effect = "Allow", Action = ["s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"], Resource = ["${local.s3}/pipeline/runs/*/curated/*", "${local.s3}/pipeline/runs/*/scored/*", "${local.s3}/pipeline/runs/*/network/*", "${local.s3}/tmp/ingest/*"] },
    { Effect = "Allow", Action = ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"], Resource = ["${local.s3}/pipeline/runs/*/curated_$folder$", "${local.s3}/pipeline/runs/*/scored_$folder$", "${local.s3}/pipeline/runs/*/network_$folder$", "${local.s3}/tmp/ingest/*/curate_$folder$", "${local.s3}/tmp/ingest/*/score_$folder$", "${local.s3}/tmp/ingest/*/network_$folder$"] },
    { Effect = "Allow", Action = ["s3:PutObject", "s3:AbortMultipartUpload"], Resource = ["${local.s3}/pipeline/runs/*/baseline/*", "${local.s3}/pipeline/runs/*/export/*"] },
    { Effect = "Allow", Action = ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"], Resource = "arn:aws:logs:${local.region}:${local.account}:log-group:/aws-glue/is459-g3-ingest*:*" },
    { Effect = "Allow", Action = ["cloudwatch:PutMetricData"], Resource = "*", Condition = { StringEquals = { "cloudwatch:namespace" = "Glue" } } }
  ] })
}
# Error/output log groups for every job, 14-day retention.
resource "aws_cloudwatch_log_group" "glue" {
  for_each          = toset(["curate/error", "curate/output", "score/error", "score/output", "baseline/error", "baseline/output", "export/error", "export/output", "network/error", "network/output"])
  name              = "/aws-glue/is459-g3-ingest-${each.key}"
  retention_in_days = 14
}
# Five Glue jobs: curate/score/network use Spark (network is self-contained,
# like curate - no extra packages); baseline/export run independent reference
# calculations on the G.2X driver. No retries; one run per job.
# Small baseline/export timeout is 30 min, Medium requests override to 60 min. Per-run paths (input/output/TempDir, expected rows) are passed
# by the workflow from the control Lambda's "begin" result.
resource "aws_glue_job" "job" {
  for_each          = toset(["curate", "score", "baseline", "export", "network"])
  name              = "is459-g3-ingest-${each.key}"
  role_arn          = aws_iam_role.glue.arn
  glue_version      = "5.0"
  worker_type       = contains(["baseline", "export"], each.key) ? "G.2X" : "G.1X"
  number_of_workers = 2
  timeout           = contains(["baseline", "export"], each.key) ? 30 : 10
  max_retries       = 0
  execution_property { max_concurrent_runs = 1 }
  command {
    name            = "glueetl"
    python_version  = "3"
    script_location = contains(["baseline", "export"], each.key) ? "s3://${local.bucket}/${local.stage_prefix[each.key]}/pipeline_stage.py" : "s3://${local.bucket}/${var.pipeline_config.artifact_prefix}/${each.key == "network" ? "network_mules.py" : "${each.key}_transactions.py"}"
  }
  # Arguments callers cannot override. Common: no bookmarks, custom log group,
  # and write a _SUCCESS marker so the control Lambda can confirm completion.
  non_overridable_arguments = merge({
    "--job-bookmark-option"    = "job-bookmark-disable"
    "--custom-logGroup-prefix" = "/aws-glue/is459-g3-ingest-${each.key}"
    "--conf"                   = "spark.hadoop.mapreduce.fileoutputcommitter.marksuccessfuljobs=true"
    # Score job only: frozen-model inputs -- model in the working directory, the
    # manifest hash to verify, the bda_pipeline package, model side-files and
    # offline wheels installed with --no-index (never from PyPI).
    # Curate job only: --behaviour true adds the rolling behavioural features.
    # Network job: self-contained like curate, needs nothing extra.
    }, each.key == "score" ? {
    "--MODEL_DIR"                              = "."
    "--MANIFEST_SHA256"                        = var.pipeline_config.model_manifest_sha256
    "--extra-py-files"                         = "s3://${local.bucket}/${var.pipeline_config.artifact_prefix}/bda_pipeline.zip"
    "--extra-files"                            = join(",", [for name in ["comparison.json", "selection.json", "features.json", "model-manifest.json", var.model_file] : "s3://${local.bucket}/${var.pipeline_config.model_prefix}/${name}"])
    "--additional-python-modules"              = "s3://${local.bucket}/${var.pipeline_config.artifact_prefix}/runtime.gluewheels.zip"
    "--python-modules-installer-option"        = "--no-index"
    # Baseline/export: package and dashboard shell from local.stage_prefix
    # (export may be pinned via var.export_deployment), plus export switches.
    } : each.key == "curate" ? { "--behaviour" = "true" } : each.key == "network" ? {} : merge({
    "--STAGE"                                  = each.key
    "--extra-py-files"                         = "s3://${local.bucket}/${local.stage_prefix[each.key]}/bda_pipeline.zip"
    "--extra-files"                            = join(",", [for name in ["index.html", "dashboard.js", "dashboard.css"] : "s3://${local.bucket}/${local.stage_prefix[each.key]}/dashboard/${name}"])
    "--additional-python-modules"              = "s3://${local.bucket}/${var.pipeline_config.artifact_prefix}/runtime.gluewheels.zip"
    "--python-modules-installer-option"        = "--no-index"
  }, each.key == "export" ? local.export_arguments : {}))
  depends_on = [aws_iam_role_policy.glue, aws_s3_object.deployment_artifact, aws_cloudwatch_log_group.glue]
}
# Role of the control Lambda (the pipeline's "brain"; code in
# src/bda_pipeline/ingest_control.py).
resource "aws_iam_role" "control" {
  name               = "is459-g3-ingest-control"
  assume_role_policy = jsonencode({ Version = "2012-10-17", Statement = [{ Effect = "Allow", Principal = { Service = "lambda.amazonaws.com" }, Action = "sts:AssumeRole" }] })
}
# Control Lambda permissions, by purpose:
resource "aws_iam_role_policy" "control" {
  role = aws_iam_role.control.id
  policy = jsonencode({ Version = "2012-10-17", Statement = [
    # - check whether dashboard/current.json exists in the dashboard bucket;
    # - read curated and network output (to verify markers);
    # - read catalog metadata.
    { Effect = "Allow", Action = ["s3:ListBucket"], Resource = local.site, Condition = { StringEquals = { "s3:prefix" = "dashboard/current.json" } } },
    { Effect = "Allow", Action = ["s3:GetBucketLocation"], Resource = local.s3 },
    { Effect = "Allow", Action = ["s3:ListBucket"], Resource = local.s3, Condition = { StringLike = { "s3:prefix" = ["pipeline/runs/*/curated/*", "pipeline/runs/*/network/*"] } } },
    { Effect = "Allow", Action = ["s3:GetObject"], Resource = ["${local.s3}/pipeline/runs/*/curated/*", "${local.s3}/pipeline/runs/*/network/*"] },
    { Effect = "Allow", Action = ["glue:GetDatabase", "glue:GetPartitions"], Resource = local.catalog },
    # - read anything under pipeline/ (manifests, config, caches, evidence), the
    #   current dashboard pointer, and published release snapshots (the
    #   'activate' op verifies a release's dashboard.json before pointing at it).
    { Effect = "Allow", Action = ["s3:ListBucket"], Resource = local.s3, Condition = { StringLike = { "s3:prefix" = "pipeline/*" } } },
    { Effect = "Allow", Action = ["s3:GetObject"], Resource = ["${local.s3}/pipeline/*", "${local.site}/dashboard/current.json", "${local.site}/dashboard/releases/*/dashboard.json"] },
    # - write: the run lock, run/stage cache receipts, curated/scored/network cache copies,
    #   run evidence, SageMaker training inputs, the dashboard release files and
    #   current.json. (The shell files stay writable for compatibility, but the
    #   control code no longer writes them.)
    { Effect = "Allow", Action = ["s3:PutObject"], Resource = ["${local.s3}/pipeline/lock.json", "${local.s3}/pipeline/cache/*", "${local.s3}/pipeline/stage-cache/*", "${local.s3}/pipeline/runs/*/curated/*", "${local.s3}/pipeline/runs/*/scored/*", "${local.s3}/pipeline/runs/*/network/*", "${local.s3}/pipeline/runs/*/evidence/*", "${local.s3}/sagemaker/inputs/is459-g3-train-*/*", "${local.site}/dashboard/releases/*/*", "${local.site}/dashboard/current.json", "${local.site}/dashboard/index.html", "${local.site}/dashboard/dashboard.js", "${local.site}/dashboard/dashboard.css"] },
    # - delete only the lock file (releasing the lock at the end of a run);
    # - create/read the per-run Athena table;
    # - see and stop this pipeline's Glue runs (cleanup after a failure);
    # - describe/stop/list SageMaker training jobs (cleanup, verification and
    #   the published-run cost estimate; List* has no resource-level scope so
    #   it needs "*");
    # - check an execution's status (manual "recover" operation);
    # - invalidate the CloudFront cache after publishing;
    # - write its own logs.
    { Effect = "Allow", Action = ["s3:DeleteObject"], Resource = "${local.s3}/pipeline/lock.json" },
    { Effect = "Allow", Action = ["glue:CreateTable", "glue:GetTable"], Resource = local.catalog },
    { Effect = "Allow", Action = ["glue:GetJobRun", "glue:GetJobRuns", "glue:BatchStopJobRun"], Resource = local.jobs },
    { Effect = "Allow", Action = ["sagemaker:StopTrainingJob"], Resource = local.training },
    { Effect = "Allow", Action = ["sagemaker:DescribeTrainingJob"], Resource = local.training },
    { Effect = "Allow", Action = ["sagemaker:ListTrainingJobs"], Resource = "*" },
    { Effect = "Allow", Action = ["states:DescribeExecution"], Resource = "arn:aws:states:${local.region}:${local.account}:execution:is459-g3-ingest:*" },
    { Effect = "Allow", Action = ["cloudfront:CreateInvalidation"], Resource = "arn:aws:cloudfront::${local.account}:distribution/${var.pipeline_config.distribution_id}" },
    { Effect = "Allow", Action = ["logs:CreateLogStream", "logs:PutLogEvents"], Resource = "${aws_cloudwatch_log_group.control.arn}:*" }
  ] })
}
# Control Lambda log group, 14-day retention.
resource "aws_cloudwatch_log_group" "control" {
  name              = "/aws/lambda/is459-g3-ingest-control"
  retention_in_days = 14
}
# The control Lambda: Python 3.12, code from control.zip in the artefact
# prefix; handler dispatches on event["op"] (begin, curated, baseline, export,
# publish, failed, training_failed, recover). 120 s timeout, 1024 MB, and
# reserved concurrency 1 so control steps never run concurrently. The config
# is passed in the PIPELINE_CONFIG environment variable.
resource "aws_lambda_function" "control" {
  function_name                  = "is459-g3-ingest-control"
  role                           = aws_iam_role.control.arn
  runtime                        = "python3.12"
  handler                        = "bda_pipeline.ingest_control.lambda_handler"
  s3_bucket                      = local.bucket
  s3_key                         = aws_s3_object.deployment_artifact["control.zip"].key
  source_code_hash               = filebase64sha256("${var.artifact_directory}/control.zip")
  timeout                        = 120
  memory_size                    = 1024
  reserved_concurrent_executions = 1
  environment { variables = { PIPELINE_CONFIG = jsonencode(var.pipeline_config) } }
  depends_on = [aws_iam_role_policy.control, aws_cloudwatch_log_group.control]
}
# Role for the state machine, trusted only for is459-g3-ingest.
resource "aws_iam_role" "workflow" {
  name               = "is459-g3-ingest-workflow"
  assume_role_policy = jsonencode({ Version = "2012-10-17", Statement = [{ Effect = "Allow", Principal = { Service = "states.amazonaws.com" }, Action = "sts:AssumeRole", Condition = { StringEquals = { "aws:SourceAccount" = local.account }, ArnEquals = { "aws:SourceArn" = local.machine } } }] })
}
# Workflow permissions:
resource "aws_iam_role_policy" "workflow" {
  role = aws_iam_role.workflow.id
  policy = jsonencode({ Version = "2012-10-17", Statement = [
    # - invoke the control Lambda;
    # - start/monitor/stop the five Glue jobs (".sync" integration);
    # - create/describe/stop/tag SageMaker training jobs;
    # - pass only the training role to SageMaker;
    # - manage the managed EventBridge rules Step Functions uses to wait for
    #   SageMaker jobs;
    # - publish failures to SNS.
    { Effect = "Allow", Action = ["lambda:InvokeFunction"], Resource = aws_lambda_function.control.arn },
    { Effect = "Allow", Action = ["glue:StartJobRun", "glue:GetJobRun", "glue:GetJobRuns", "glue:BatchStopJobRun"], Resource = local.jobs },
    { Effect = "Allow", Action = ["sagemaker:CreateTrainingJob", "sagemaker:DescribeTrainingJob", "sagemaker:StopTrainingJob", "sagemaker:AddTags", "sagemaker:ListTags"], Resource = local.training },
    { Effect = "Allow", Action = ["iam:PassRole"], Resource = ["arn:aws:iam::${local.account}:role/is459-g3-sagemaker-training"], Condition = { StringEquals = { "iam:PassedToService" = "sagemaker.amazonaws.com" } } },
    { Effect = "Allow", Action = ["events:PutRule", "events:PutTargets", "events:DescribeRule"], Resource = [for name in ["StepFunctionsGetEventsForSageMakerTrainingJobsRule"] : "arn:aws:events:${local.region}:${local.account}:rule/${name}"] },
    { Effect = "Allow", Action = ["sns:Publish"], Resource = local.failure_topic }
  ] })
}
# The state machine. workflow.asl.json is produced by build-workflow.py and
# templatefile() fills in ${control_arn} and ${failure_topic}. depends_on makes
# sure jobs, roles and the config object exist before any run can start.
resource "aws_sfn_state_machine" "ingest" {
  name       = "is459-g3-ingest"
  role_arn   = aws_iam_role.workflow.arn
  type       = "STANDARD"
  definition = templatefile("${path.module}/workflow.asl.json", { control_arn = aws_lambda_function.control.arn, failure_topic = local.failure_topic })
  depends_on = [aws_iam_role_policy.workflow, aws_glue_job.job, aws_s3_object.configuration]
}
# Terminal-cleanup rule: whenever an is459-g3-ingest execution ends FAILED,
# TIMED_OUT or ABORTED (including manual aborts that skip the workflow's own
# failure path), EventBridge invokes the control Lambda, which records failure
# evidence and requests stops for that run's still-running Glue/SageMaker jobs.
resource "aws_cloudwatch_event_rule" "cancel_workers" {
  name = "is459-g3-ingest-terminal-cleanup"
  event_pattern = jsonencode({ source = ["aws.states"], "detail-type" = ["Step Functions Execution Status Change"],
  detail = { stateMachineArn = [local.machine], status = ["FAILED", "TIMED_OUT", "ABORTED"] } })
}
# Resource-based permission letting EventBridge (only this rule, only from
# this account) invoke the control Lambda.
resource "aws_lambda_permission" "cancel_workers" {
  statement_id   = "IngestTerminalCleanup"
  action         = "lambda:InvokeFunction"
  function_name  = aws_lambda_function.control.function_name
  principal      = "events.amazonaws.com"
  source_arn     = aws_cloudwatch_event_rule.cancel_workers.arn
  source_account = local.account
}
# Target with 3 retries within 1 hour, because missed cleanup could leave paid
# workers running.
resource "aws_cloudwatch_event_target" "cancel_workers" {
  rule = aws_cloudwatch_event_rule.cancel_workers.name
  arn  = aws_lambda_function.control.arn
  retry_policy {
    maximum_event_age_in_seconds = 3600
    maximum_retry_attempts       = 3
  }
  depends_on = [aws_lambda_permission.cancel_workers]
}
# Outputs: workflow ARN; a hash of the deployed config (to detect drift); and
# the minimal launcher policy a human/CI identity needs to upload raw inputs,
# start/watch a run and call the control Lambda (review only, not attached).
output "state_machine_arn" { value = aws_sfn_state_machine.ingest.arn }
output "deployment_sha256" { value = sha256(jsonencode(var.pipeline_config)) }
output "launcher_policy_json" {
  value = jsonencode({ Version = "2012-10-17", Statement = [
    { Effect = "Allow", Action = ["s3:ListBucket"], Resource = local.s3, Condition = { StringLike = { "s3:prefix" = ["pipeline/deployment.json", "pipeline/cache/*"] } } },
    { Effect = "Allow", Action = ["s3:GetObject"], Resource = ["${local.s3}/pipeline/deployment.json", "${local.s3}/pipeline/cache/*"] },
    { Effect = "Allow", Action = ["s3:PutObject", "s3:AbortMultipartUpload"], Resource = "${local.s3}/pipeline/runs/*/raw/*" },
    { Effect = "Allow", Action = ["states:StartExecution"], Resource = local.machine },
    { Effect = "Allow", Action = ["states:DescribeExecution"], Resource = "arn:aws:states:${local.region}:${local.account}:execution:is459-g3-ingest:*" },
    { Effect = "Allow", Action = ["lambda:InvokeFunction"], Resource = aws_lambda_function.control.arn }
  ] })
}
