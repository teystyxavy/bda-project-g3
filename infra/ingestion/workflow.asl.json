{
  "Comment": "Parallel verified full batch; Glue stages and bounded training checks; no paid-job retries.",
  "StartAt": "Begin",
  "TimeoutSeconds": 43200,
  "States": {
    "Begin": {
      "Type": "Task",
      "Resource": "${control_arn}",
      "Parameters": {
        "op": "begin",
        "run_id.$": "$.run_id"
      },
      "ResultPath": "$.work",
      "Next": "ReuseCurated",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 3,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ]
    },
    "ReuseCurated": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.work.curated_cache_hit",
          "BooleanEquals": true,
          "Next": "PrepareBaseline"
        }
      ],
      "Default": "Curate"
    },
    "Curate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "is459-g3-ingest-curate",
        "Arguments.$": "$.work.curate_arguments",
        "WorkerType": "G.1X",
        "NumberOfWorkers.$": "$.work.glue_workers",
        "Timeout.$": "$.work.glue_timeout"
      },
      "ResultPath": null,
      "Next": "PrepareBaseline",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ]
    },
    "PrepareBaseline": {
      "Type": "Task",
      "Resource": "${control_arn}",
      "Parameters": {
        "op": "curated",
        "run_id.$": "$.run_id"
      },
      "ResultPath": "$.baseline_request",
      "Next": "ScoreAndAnalyze",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 3,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ]
    },
    "ScoreAndAnalyze": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "Baseline",
          "States": {
            "Baseline": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName.$": "$.baseline_request.JobName",
                "Arguments.$": "$.baseline_request.Arguments",
                "WorkerType.$": "$.baseline_request.WorkerType",
                "NumberOfWorkers.$": "$.baseline_request.NumberOfWorkers",
                "Timeout.$": "$.baseline_request.Timeout"
              },
              "ResultPath": "$.baseline_job",
              "Next": "PrepareBranches"
            },
            "PrepareBranches": {
              "Type": "Task",
              "Resource": "${control_arn}",
              "Parameters": {
                "op": "baseline",
                "run_id.$": "$.run_id",
                "job_result.$": "$.baseline_job"
              },
              "ResultPath": "$.training",
              "Next": "TrainRequested",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 3,
                  "MaxAttempts": 2,
                  "BackoffRate": 2
                }
              ]
            },
            "TrainRequested": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.work.train",
                  "BooleanEquals": true,
                  "Next": "Train"
                }
              ],
              "Default": "ReuseFrozen"
            },
            "TrainDone": {
              "Type": "Pass",
              "End": true
            },
            "ReuseFrozen": {
              "Type": "Pass",
              "End": true
            },
            "Train": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:sagemaker:createTrainingJob",
              "Parameters": {
                "TrainingJobName.$": "$.training.training_request.TrainingJobName",
                "RoleArn.$": "$.training.training_request.RoleArn",
                "AlgorithmSpecification.$": "$.training.training_request.AlgorithmSpecification",
                "InputDataConfig.$": "$.training.training_request.InputDataConfig",
                "OutputDataConfig.$": "$.training.training_request.OutputDataConfig",
                "ResourceConfig.$": "$.training.training_request.ResourceConfig",
                "StoppingCondition.$": "$.training.training_request.StoppingCondition",
                "HyperParameters.$": "$.training.training_request.HyperParameters",
                "EnableNetworkIsolation.$": "$.training.training_request.EnableNetworkIsolation",
                "EnableManagedSpotTraining.$": "$.training.training_request.EnableManagedSpotTraining",
                "EnableInterContainerTrafficEncryption.$": "$.training.training_request.EnableInterContainerTrafficEncryption",
                "ProfilerConfig.$": "$.training.training_request.ProfilerConfig",
                "Tags.$": "$.training.training_request.Tags"
              },
              "ResultPath": null,
              "Next": "TrainPollInit"
            },
            "TrainPollInit": {
              "Type": "Pass",
              "Result": {
                "attempt": 0
              },
              "ResultPath": "$.poll",
              "Next": "TrainWait"
            },
            "TrainWait": {
              "Type": "Wait",
              "Seconds": 15,
              "Next": "TrainStatus"
            },
            "TrainStatus": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:sagemaker:describeTrainingJob",
              "Parameters": {
                "TrainingJobName.$": "$.training.training_request.TrainingJobName"
              },
              "ResultSelector": {
                "status.$": "$.TrainingJobStatus"
              },
              "ResultPath": "$.job_status",
              "Next": "TrainComplete",
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.TaskFailed"
                  ],
                  "IntervalSeconds": 3,
                  "MaxAttempts": 2,
                  "BackoffRate": 2
                }
              ]
            },
            "TrainComplete": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.job_status.status",
                  "StringEquals": "Completed",
                  "Next": "TrainDone"
                },
                {
                  "Or": [
                    {
                      "Variable": "$.job_status.status",
                      "StringEquals": "Failed"
                    },
                    {
                      "Variable": "$.job_status.status",
                      "StringEquals": "Stopped"
                    }
                  ],
                  "Next": "TrainFailed"
                },
                {
                  "Variable": "$.poll.attempt",
                  "NumericGreaterThanEquals": 299,
                  "Next": "TrainFailed"
                }
              ],
              "Default": "TrainPollIncrement"
            },
            "TrainPollIncrement": {
              "Type": "Pass",
              "Parameters": {
                "attempt.$": "States.MathAdd($.poll.attempt, 1)"
              },
              "ResultPath": "$.poll",
              "Next": "TrainWait"
            },
            "TrainFailed": {
              "Type": "Fail",
              "Error": "TrainingFailedOrDeadline",
              "Cause": "Training did not succeed within 300 checks; preserve outputs and stop owned workers."
            }
          }
        },
        {
          "StartAt": "ReuseScores",
          "States": {
            "ReuseScores": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.work.scored_cache_hit",
                  "BooleanEquals": true,
                  "Next": "ScoresReused"
                }
              ],
              "Default": "Score"
            },
            "Score": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "is459-g3-ingest-score",
                "Arguments.$": "$.work.score_arguments",
                "WorkerType": "G.1X",
                "NumberOfWorkers.$": "$.work.glue_workers",
                "Timeout.$": "$.work.glue_timeout"
              },
              "ResultPath": null,
              "End": true
            },
            "ScoresReused": {
              "Type": "Pass",
              "End": true
            }
          }
        },
        {
          "StartAt": "ReuseNetwork",
          "States": {
            "ReuseNetwork": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.work.network_cache_hit",
                  "BooleanEquals": true,
                  "Next": "NetworkReused"
                }
              ],
              "Default": "Network"
            },
            "Network": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "is459-g3-ingest-network",
                "Arguments.$": "$.work.network_arguments",
                "WorkerType": "G.1X",
                "NumberOfWorkers.$": "$.work.glue_workers",
                "Timeout.$": "$.work.glue_timeout"
              },
              "ResultPath": null,
              "End": true
            },
            "NetworkReused": {
              "Type": "Pass",
              "End": true
            }
          }
        }
      ],
      "ResultPath": null,
      "Next": "PrepareExport",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ]
    },
    "PrepareExport": {
      "Type": "Task",
      "Resource": "${control_arn}",
      "Parameters": {
        "op": "export",
        "run_id.$": "$.run_id"
      },
      "ResultPath": "$.export_request",
      "Next": "Export",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 3,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ]
    },
    "Export": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName.$": "$.export_request.JobName",
        "Arguments.$": "$.export_request.Arguments",
        "WorkerType.$": "$.export_request.WorkerType",
        "NumberOfWorkers.$": "$.export_request.NumberOfWorkers",
        "Timeout.$": "$.export_request.Timeout"
      },
      "ResultPath": "$.export_job",
      "Next": "Publish",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ]
    },
    "Publish": {
      "Type": "Task",
      "Resource": "${control_arn}",
      "Parameters": {
        "op": "publish",
        "run_id.$": "$.run_id",
        "job_result.$": "$.export_job"
      },
      "ResultPath": "$",
      "Next": "Complete",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 3,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ]
    },
    "Complete": {
      "Type": "Succeed"
    },
    "RecordFailure": {
      "Type": "Task",
      "Resource": "${control_arn}",
      "Parameters": {
        "op": "failed",
        "run_id.$": "$.run_id",
        "failure.$": "$.failure"
      },
      "ResultPath": null,
      "Next": "NotifyFailure",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": null,
          "Next": "NotifyFailure"
        }
      ]
    },
    "NotifyFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${failure_topic}",
        "Message.$": "States.JsonToString($.failure)"
      },
      "ResultPath": null,
      "Next": "Failed",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": null,
          "Next": "Failed"
        }
      ]
    },
    "Failed": {
      "Type": "Fail",
      "Error": "IngestFailed",
      "Cause": "Run outputs preserved; inspect evidence and recover only after all workers stop."
    }
  }
}
