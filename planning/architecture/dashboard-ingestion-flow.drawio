        <mxCell id="results" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=1;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;strokeColor=#526273;" edge="1" parent="1" source="cdn" target="browser">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="status" value="&lt;b&gt;Live status&lt;/b&gt;&lt;br&gt;Authenticated API reads both workflow histories without payloads. The browser updates phase colours and names the active Lambda, Glue, Athena or SageMaker step every 10 seconds." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=19;fontColor=#232F3E;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1710" y="770" width="580" height="180" />
        </mxCell>
        <mxCell id="meaning" value="&lt;b&gt;Progress meaning&lt;/b&gt;&lt;br&gt;Green: active phase. Light green: complete. Purple: reused/skipped. Red: failed/stopped. Parallel boxes may be active together. S3 writes inside acquisition and publication do not have individual byte/row counters." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=19;fontColor=#232F3E;fontFamily=Helvetica;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="1130" width="2200" height="150" />
        </mxCell>
      </root>
