        <mxCell id="bq2-b-11" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1420" y="170" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="bq2-b-12" value="1 · Inside the Glue network job (Spark)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=light-dark(#D866131A,#D8661333);fillStyle=auto;strokeColor=#D86613;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=15;fontStyle=1;fontColor=#D86613;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="1840" height="250" as="geometry" /></mxCell>
        <mxCell id="bq2-b-13" value="&lt;b style=&quot;font-size: 16px;&quot;&gt;Link&lt;/b&gt;&lt;br&gt;&lt;br&gt;Merge repeated payments A→B into one directed link; drop self-transfers" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1B2631);strokeColor=#D86613;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;fontSize=14;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="500" width="260" height="160" as="geometry" /></mxCell>
        <mxCell id="bq2-b-14" value="&lt;b style=&quot;font-size: 16px;&quot;&gt;Fan-in / out&lt;/b&gt;&lt;br&gt;&lt;br&gt;Count distinct senders into and receivers out of each account" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1B2631);strokeColor=#D86613;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;fontSize=14;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="500" width="260" height="160" as="geometry" /></mxCell>
        <mxCell id="bq2-e-15" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#D86613;strokeWidth=2;rounded=0;jumpStyle=arc;fontSize=13;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bq2-b-13" target="bq2-b-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bq2-b-16" value="&lt;b style=&quot;font-size: 16px;&quot;&gt;Hubs&lt;/b&gt;&lt;br&gt;&lt;br&gt;Fan-in ≥ 10 &lt;b&gt;and&lt;/b&gt; fan-out ≥ 10, ≤ 100 links (bigger = merchant-like)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1B2631);strokeColor=#D86613;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;fontSize=14;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="670" y="500" width="260" height="160" as="geometry" /></mxCell>
        <mxCell id="bq2-e-17" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#D86613;strokeWidth=2;rounded=0;jumpStyle=arc;fontSize=13;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bq2-b-14" target="bq2-b-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bq2-b-18" value="&lt;b style=&quot;font-size: 16px;&quot;&gt;Loops&lt;/b&gt;&lt;br&gt;&lt;br&gt;A → B → C → A in order within 7 days" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1B2631);strokeColor=#D86613;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;fontSize=14;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="970" y="500" width="260" height="160" as="geometry" /></mxCell>
        <mxCell id="bq2-e-19" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#D86613;strokeWidth=2;rounded=0;jumpStyle=arc;fontSize=13;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bq2-b-16" target="bq2-b-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bq2-b-20" value="&lt;b style=&quot;font-size: 16px;&quot;&gt;Rings&lt;/b&gt;&lt;br&gt;&lt;br&gt;Connected groups of ≥ 3 accounts (min-label propagation). &lt;b&gt;1 ring = 1 case&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1B2631);strokeColor=#D86613;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;fontSize=14;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1270" y="500" width="260" height="160" as="geometry" /></mxCell>
        <mxCell id="bq2-e-21" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#D86613;strokeWidth=2;rounded=0;jumpStyle=arc;fontSize=13;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bq2-b-18" target="bq2-b-20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bq2-b-22" value="&lt;b style=&quot;font-size: 16px;&quot;&gt;Rank&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hubs, then loops, then payments. Labels never change the order" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1B2631);strokeColor=#D86613;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;fontSize=14;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1570" y="500" width="260" height="160" as="geometry" /></mxCell>
        <mxCell id="bq2-e-23" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#D86613;strokeWidth=2;rounded=0;jumpStyle=arc;fontSize=13;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bq2-b-20" target="bq2-b-22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bq2-e-24" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#D86613;strokeWidth=1;rounded=0;jumpStyle=arc;fontSize=13;fontFamily=Helvetica;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.255;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bq2-net" target="bq2-b-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bq2-e-24-l" value="zoom in" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=none;fontSize=13;fontStyle=1;fontFamily=Helvetica;" connectable="0" vertex="1" parent="bq2-e-24"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="36" y="0" as="offset" /></mxGeometry></mxCell>
        <mxCell id="bq2-b-25" value="&lt;div style=&quot;margin-left: 34px;&quot;&gt;&lt;b style=&quot;font-size: 16px;&quot;&gt;Verify (Glue export)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top: 8px;&quot;&gt;Recomputes hubs, loops and rings independently in pandas and compares every table with the Spark output.&lt;br&gt;USD must match within 1 cent and the shape must be plausible, or &lt;b&gt;nothing is published&lt;/b&gt;.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1B2631);strokeColor=#D86613;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=14;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="600" height="220" as="geometry" /></mxCell>
        <mxCell id="bq2-b-26" value="&lt;div style=&quot;margin-left: 34px;&quot;&gt;&lt;b style=&quot;font-size: 16px;&quot;&gt;Results: HI-Small (5.08M payments)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top: 8px;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D86613&quot; style=&quot;font-size: 22px;&quot;&gt;202 rings&lt;/font&gt;&lt;/b&gt; · 1,110 accounts&lt;br&gt;&lt;b&gt;44.3%&lt;/b&gt; of ring accounts touch laundering (&lt;b&gt;29.5×&lt;/b&gt; the 1.5% base rate)&lt;br&gt;Mule-sized hubs: &lt;b&gt;16 of 20 (80%)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Local run, 1 Nov 2026&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1B2631);strokeColor=#D86613;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=14;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="660" y="720" width="600" height="220" as="geometry" /></mxCell>
        <mxCell id="bq2-b-27" value="&lt;div&gt;&lt;b style=&quot;font-size: 16px;&quot;&gt;Out-of-sample: HI-Medium (31.9M payments)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top: 8px;&quot;&gt;Same thresholds, nothing re-tuned:&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#D86613&quot; style=&quot;font-size: 22px;&quot;&gt;94.4%&lt;/font&gt;&lt;/b&gt; of 125 mule-sized hubs touch laundering&lt;br&gt;Ring accounts: &lt;b&gt;37.3%&lt;/b&gt; (2.4% base rate)&lt;br&gt;&lt;br&gt;&lt;i&gt;Local run, 4 Nov 2026&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1B2631);strokeColor=#D86613;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=14;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1280" y="720" width="600" height="220" as="geometry" /></mxCell>
        <mxCell id="bq2-b-28" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="728" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="bq2-b-29" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="670" y="728" width="28" height="28" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
