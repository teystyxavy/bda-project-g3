        <mxCell id="bq1-b-15" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="280" y="300" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="bq1-b-16" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="700" y="215" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="bq1-b-17" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="730" y="430" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="bq1-b-18" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1220" y="300" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="bq1-b-19" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1540" y="300" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="bq1-b-20" value="&lt;div style=&quot;margin-left: 34px;&quot;&gt;&lt;b style=&quot;font-size: 16px;&quot;&gt;Curate: 15 features&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top: 8px;&quot;&gt;Earlier events only, so no look-ahead:&lt;br&gt;• sender counts 1h / 24h / 7d, counterparties, USD sums&lt;br&gt;• the same 7 for the receiver&lt;br&gt;• pair novelty (prior payments A→B)&lt;br&gt;• USD at the &lt;b&gt;previous-day&lt;/b&gt; FX rate&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1B2631);strokeColor=#147EBA;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=14;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="356" height="230" as="geometry" /></mxCell>
        <mxCell id="bq1-b-21" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="708" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="bq1-b-22" value="&lt;div style=&quot;margin-left: 34px;&quot;&gt;&lt;b style=&quot;font-size: 16px;&quot;&gt;Rule baseline&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top: 8px;&quot;&gt;Glue re-checks every curated row against the raw CSVs, then scores:&lt;br&gt;• +50 ACH&lt;br&gt;• +20 above training P99 amount&lt;br&gt;• +30 high velocity or fan-out&lt;br&gt;Flagged at ≥ 60&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1B2631);strokeColor=#147EBA;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=14;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="412" y="700" width="356" height="230" as="geometry" /></mxCell>
        <mxCell id="bq1-b-23" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="422" y="708" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="bq1-b-24" value="&lt;div style=&quot;margin-left: 34px;&quot;&gt;&lt;b style=&quot;font-size: 16px;&quot;&gt;Frozen XGBoost&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top: 8px;&quot;&gt;Trained offline on chronological train / validation / test windows; model hash pinned.&lt;br&gt;Spark ships the model to every worker and scores all rows.&lt;br&gt;Score is a &lt;b&gt;ranking&lt;/b&gt;, not a probability.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1B2631);strokeColor=#147EBA;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=14;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="784" y="700" width="356" height="230" as="geometry" /></mxCell>
        <mxCell id="bq1-b-25" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="794" y="708" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="bq1-b-26" value="&lt;div style=&quot;margin-left: 34px;&quot;&gt;&lt;b style=&quot;font-size: 16px;&quot;&gt;Verify + evaluate&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top: 8px;&quot;&gt;Reproduces every model score, then computes precision, recall and lift at K = 100 and average precision against the baseline.&lt;br&gt;Builds the top-2,000 queue with SHAP explanations.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1B2631);strokeColor=#147EBA;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=14;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1156" y="700" width="356" height="230" as="geometry" /></mxCell>
        <mxCell id="bq1-b-27" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1166" y="708" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="bq1-b-28" value="&lt;div style=&quot;margin-left: 34px;&quot;&gt;&lt;b style=&quot;font-size: 16px;&quot;&gt;Result&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top: 8px;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#147EBA&quot; style=&quot;font-size: 22px;&quot;&gt;44%&lt;/font&gt;&lt;/b&gt; precision@100&lt;br&gt;vs &lt;b&gt;0%&lt;/b&gt; for the rule baseline (test period)&lt;br&gt;&lt;br&gt;Investigators work the ranked queue top-down.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1B2631);strokeColor=#147EBA;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=14;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1528" y="700" width="356" height="230" as="geometry" /></mxCell>
        <mxCell id="bq1-b-29" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1538" y="708" width="28" height="28" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
