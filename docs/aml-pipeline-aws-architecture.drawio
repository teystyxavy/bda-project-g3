        <mxCell id="cache-b-26" value="&lt;b&gt;Cached stages:&lt;/b&gt; curate, BQ1 score, BQ2 network&lt;br&gt;&lt;b&gt;Key (SHA-256):&lt;/b&gt;&lt;br&gt;• curate: inputs + dataset + code version&lt;br&gt;• score: + frozen model hash&lt;br&gt;• network: + network job version&lt;br&gt;&lt;b&gt;Hit:&lt;/b&gt; S3 copy with &lt;font face=&quot;Courier New&quot;&gt;CopySourceIfMatch&lt;/font&gt;&lt;br&gt;&lt;b&gt;Tampered receipt:&lt;/b&gt; the run fails&lt;br&gt;&lt;b&gt;Bypass:&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;-Rerun&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=14;spacing=8;fontSize=14;fontColor=light-dark(#232F3E,#F5F5F5);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1260" y="700" width="600" height="290" as="geometry" /></mxCell>
