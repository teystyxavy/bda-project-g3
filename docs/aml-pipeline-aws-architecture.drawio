        <mxCell id="ov-t-23" value="&lt;i&gt;Parquet partitioned by date&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=12;align=center;fontColor=light-dark(#545B64,#D5DBDB);" vertex="1" parent="1"><mxGeometry x="600" y="541" width="180" height="22" as="geometry" /></mxCell>
        <mxCell id="ov-t-24" value="&lt;i&gt;publishes only if checks match&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=12;align=center;fontColor=light-dark(#545B64,#D5DBDB);" vertex="1" parent="1"><mxGeometry x="1100" y="541" width="180" height="22" as="geometry" /></mxCell>
        <mxCell id="ov-b-25" value="↺ cacheable" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=light-dark(#E8F5E9,#1E3320);strokeColor=#3F8624;fontSize=11;fontStyle=1;fontColor=light-dark(#1D8102,#9BE58A);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="645" y="566" width="90" height="20" as="geometry" /></mxCell>
        <mxCell id="ov-b-26" value="↺ cacheable" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=light-dark(#E8F5E9,#1E3320);strokeColor=#3F8624;fontSize=11;fontStyle=1;fontColor=light-dark(#1D8102,#9BE58A);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="965" y="300" width="90" height="20" as="geometry" /></mxCell>
        <mxCell id="ov-b-27" value="↺ cacheable" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=light-dark(#E8F5E9,#1E3320);strokeColor=#3F8624;fontSize=11;fontStyle=1;fontColor=light-dark(#1D8102,#9BE58A);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="965" y="554" width="90" height="20" as="geometry" /></mxCell>
        <mxCell id="ov-b-28" value="always runs" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=light-dark(#FCE4EC,#3A1F2B);strokeColor=#CD2264;fontSize=11;fontStyle=1;fontColor=light-dark(#CD2264,#F7A6C6);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1145" y="566" width="90" height="20" as="geometry" /></mxCell>
        <mxCell id="ov-b-29" value="&lt;b style=&quot;font-size: 17px;&quot;&gt;1  Ingest&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size: 13px;&quot;&gt;AWS Lambda · Amazon S3 · Step Functions&lt;/i&gt;&lt;div style=&quot;margin-top: 8px; font-size: 15px;&quot;&gt;A container-image Lambda downloads the Kaggle IBM AML files and daily FX rates (Frankfurter/ECB, Yahoo for BTC, RUB, SAR) and writes CSVs + a manifest to the private, versioned S3 data lake. It reuses a verified S3 copy of the Kaggle files, and an identical published run returns its release without starting the batch.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1B2631);strokeColor=#6c8ebf;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=14;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="450" height="230" as="geometry" /></mxCell>
        <mxCell id="ov-b-30" value="&lt;b style=&quot;font-size: 17px;&quot;&gt;2  Curate&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size: 13px;&quot;&gt;AWS Glue (Spark) · Amazon S3&lt;/i&gt;&lt;div style=&quot;margin-top: 8px; font-size: 15px;&quot;&gt;Glue validates every field, joins sender and receiver account data, converts 15 currencies to USD (same-day and previous-day rates) and adds prior-event features. Writes Parquet partitioned by date: &lt;b&gt;5,078,345&lt;/b&gt; rows for HI-Small, &lt;b&gt;31.9M&lt;/b&gt; for HI-Medium. The row count must not change.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1B2631);strokeColor=#6c8ebf;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=14;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="505" y="780" width="450" height="230" as="geometry" /></mxCell>
        <mxCell id="ov-b-31" value="&lt;b style=&quot;font-size: 17px;&quot;&gt;3  Analyse&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size: 13px;&quot;&gt;AWS Glue (Spark) × 2, in parallel&lt;/i&gt;&lt;div style=&quot;margin-top: 8px; font-size: 15px;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#147EBA&quot;&gt;BQ1&lt;/font&gt;&lt;/b&gt; scores every payment with a frozen XGBoost model to build a ranked review queue. &lt;b&gt;&lt;font color=&quot;#D86613&quot;&gt;BQ2&lt;/font&gt;&lt;/b&gt; turns who paid whom into a graph and finds mule hubs, loops and rings, one ring per case. A Glue baseline job re-checks curation alongside. Unchanged stages are copied from the stage cache.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1B2631);strokeColor=#6c8ebf;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=14;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="970" y="780" width="450" height="230" as="geometry" /></mxCell>
        <mxCell id="ov-b-32" value="&lt;b style=&quot;font-size: 17px;&quot;&gt;4  Publish&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size: 13px;&quot;&gt;AWS Glue · AWS Lambda · Amazon S3 · CloudFront&lt;/i&gt;&lt;div style=&quot;margin-top: 8px; font-size: 15px;&quot;&gt;Glue export reproduces every BQ1 score and recomputes the BQ2 network independently; nothing is published unless both match. A control Lambda checks the release file hashes, copies them to the private dashboard bucket and refreshes CloudFront. Failures email the team through SNS.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1B2631);strokeColor=#6c8ebf;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=14;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1435" y="780" width="450" height="230" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
