        <mxCell id="step-1-desc-legend" value="&lt;div&gt;&lt;b&gt;Launch a run&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Signed-in operators start or cancel HI-Small demo, custom or full runs through the protected control API. The Lambda records each launch in DynamoDB. The ingest.ps1 CLI can start the same workflows.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-1-legend"><mxGeometry x="52" y="0" width="548" height="96" as="geometry" /></mxCell>
        <mxCell id="step-2-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry x="0" y="104" width="600" height="96" as="geometry" /></mxCell>
        <mxCell id="step-2-badge-legend" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-2-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-2-desc-legend" value="&lt;div&gt;&lt;b&gt;Acquire source data&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Step Functions is459-g3-cloud-ingest invokes the container-image Lambda, which downloads the IBM AML files from Kaggle (reusing a verified S3 copy) and historical FX rates. An identical published run returns its release without starting the batch.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-2-legend"><mxGeometry x="52" y="0" width="548" height="96" as="geometry" /></mxCell>
        <mxCell id="step-3-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry x="0" y="208" width="600" height="96" as="geometry" /></mxCell>
        <mxCell id="step-3-badge-legend" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-3-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-3-desc-legend" value="&lt;div&gt;&lt;b&gt;Land raw data&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Source CSVs, FX rates and a manifest land in the private, versioned S3 data lake under pipeline/runs/&amp;lt;run_id&amp;gt;/raw/.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-3-legend"><mxGeometry x="52" y="0" width="548" height="96" as="geometry" /></mxCell>
        <mxCell id="step-4-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry x="0" y="312" width="600" height="96" as="geometry" /></mxCell>
        <mxCell id="step-4-badge-legend" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-4-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-4-desc-legend" value="&lt;div&gt;&lt;b&gt;Opt-in event start&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;For local uploads, writing raw/trigger.json fires S3 Object Created. EventBridge starts is459-g3-raw-trigger, which starts the batch exactly once.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-4-legend"><mxGeometry x="52" y="0" width="548" height="96" as="geometry" /></mxCell>
        <mxCell id="step-5-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry x="0" y="416" width="600" height="96" as="geometry" /></mxCell>
        <mxCell id="step-5-badge-legend" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-5-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-5-desc-legend" value="&lt;div&gt;&lt;b&gt;Orchestrate the batch&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;is459-g3-ingest calls the control Lambda to validate the manifest, take the single pipeline lock and check stage caches.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-5-legend"><mxGeometry x="52" y="0" width="548" height="96" as="geometry" /></mxCell>
        <mxCell id="step-6-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry x="0" y="520" width="600" height="96" as="geometry" /></mxCell>
        <mxCell id="step-6-badge-legend" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-6-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-6-desc-legend" value="&lt;div&gt;&lt;b&gt;Curate&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Glue curate converts CSV + FX into date-partitioned Parquet with preceding-event features. Skipped on a curated cache hit.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-6-legend"><mxGeometry x="52" y="0" width="548" height="96" as="geometry" /></mxCell>
        <mxCell id="step-7-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry x="0" y="624" width="600" height="96" as="geometry" /></mxCell>
        <mxCell id="step-7-badge-legend" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-7-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-7-desc-legend" value="&lt;div&gt;&lt;b&gt;Analyse in parallel&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Glue baseline verification (plus optional SageMaker candidate training, never auto-promoted), Glue BQ1 XGBoost scoring and Glue BQ2 mule-network detection. Scoring and network are each skipped on a stage-cache hit; baseline always runs.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-7-legend"><mxGeometry x="52" y="0" width="548" height="96" as="geometry" /></mxCell>
        <mxCell id="step-8-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry x="0" y="728" width="600" height="96" as="geometry" /></mxCell>
        <mxCell id="step-8-badge-legend" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-8-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-8-desc-legend" value="&lt;div&gt;&lt;b&gt;Build the release&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Glue export reconciles scores and network tables and builds the dashboard release files.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-8-legend"><mxGeometry x="52" y="0" width="548" height="96" as="geometry" /></mxCell>
        <mxCell id="step-9-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry x="0" y="832" width="600" height="96" as="geometry" /></mxCell>
        <mxCell id="step-9-badge-legend" value="9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-9-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-9-desc-legend" value="&lt;div&gt;&lt;b&gt;Publish&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;The control Lambda verifies hashes, copies the release to the private dashboard bucket, updates current.json, invalidates CloudFront and releases the lock.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-9-legend"><mxGeometry x="52" y="0" width="548" height="96" as="geometry" /></mxCell>
        <mxCell id="step-10-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry x="0" y="936" width="600" height="96" as="geometry" /></mxCell>
        <mxCell id="step-10-badge-legend" value="10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-10-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-10-desc-legend" value="&lt;div&gt;&lt;b&gt;Serve and report status&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;CloudFront serves the dashboard through OAC. Its Ingestion tab polls the public read-only status API, whose Lambda reads Step Functions executions.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-10-legend"><mxGeometry x="52" y="0" width="548" height="96" as="geometry" /></mxCell>
        <mxCell id="step-11-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry x="0" y="1040" width="600" height="96" as="geometry" /></mxCell>
        <mxCell id="step-11-badge-legend" value="11" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-11-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-11-desc-legend" value="&lt;div&gt;&lt;b&gt;Alert on failure&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Failures are recorded as evidence, SNS emails the team and an EventBridge rule asks the control Lambda to stop running workers.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-11-legend"><mxGeometry x="52" y="0" width="548" height="96" as="geometry" /></mxCell>
        <mxCell id="step-12-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry x="0" y="1144" width="600" height="96" as="geometry" /></mxCell>
        <mxCell id="step-12-badge-legend" value="12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-12-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-12-desc-legend" value="&lt;div&gt;&lt;b&gt;Ad hoc analysis&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Athena queries the per-run run_&amp;lt;id&amp;gt; tables registered in the Glue Data Catalog.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-12-legend"><mxGeometry x="52" y="0" width="548" height="96" as="geometry" /></mxCell>
        <mxCell id="step-13-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry x="0" y="1248" width="600" height="96" as="geometry" /></mxCell>
        <mxCell id="step-13-badge-legend" value="13" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-13-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-13-desc-legend" value="&lt;div&gt;&lt;b&gt;Streaming demo (parked)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;A bounded CSV replay feeds Kinesis. Lambda recomputes features and the frozen-model score, updates DynamoDB atomically and writes audit evidence to S3.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-13-legend"><mxGeometry x="52" y="0" width="548" height="96" as="geometry" /></mxCell>
        <mxCell id="legend-aux-note" value="&lt;i&gt;Auxiliary services (no step number): CloudWatch collects Lambda, Glue and API logs and alarms; IAM scopes a least-privilege role per stage. ECR holds the acquisition, training and streaming images. Terraform state lives in a locked S3 backend.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontColor=light-dark(#333333,#E0E0E0);fontFamily=Helvetica;" vertex="1" parent="legend-container"><mxGeometry x="0" y="1358" width="600" height="70" as="geometry" /></mxCell>
        <mxCell id="legend-line-styles-group" connectable="0" value="" style="group;fontFamily=Helvetica;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;" vertex="1" parent="legend-container"><mxGeometry x="0" y="1442" width="456" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-line-box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;fontFamily=Helvetica;" vertex="1" parent="legend-line-styles-group"><mxGeometry x="0" y="0" width="456" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-line-title" value="&lt;b&gt;Line styles&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;labelBackgroundColor=none;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;" vertex="1" parent="legend-line-styles-group"><mxGeometry x="12" y="6" width="200" height="24" as="geometry" /></mxCell>
        <mxCell id="legend-line-0" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#545B64;fontFamily=Helvetica;" edge="1" parent="legend-line-styles-group"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="16" y="46" as="sourcePoint" /><mxPoint x="110" y="46" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="legend-line-0-text" value="Data / control flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;labelBackgroundColor=none;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;" vertex="1" parent="legend-line-styles-group"><mxGeometry x="124" y="34" width="300" height="24" as="geometry" /></mxCell>
        <mxCell id="legend-line-1" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#545B64;dashed=1;fontFamily=Helvetica;" edge="1" parent="legend-line-styles-group"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="16" y="76" as="sourcePoint" /><mxPoint x="110" y="76" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="legend-line-1-text" value="Failure path" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;labelBackgroundColor=none;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;" vertex="1" parent="legend-line-styles-group"><mxGeometry x="124" y="64" width="300" height="24" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
