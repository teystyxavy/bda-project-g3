        <mxCell id="cache-t-1" value="Caching: skip repeated compute, never skip verification" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=30;fontStyle=1;align=left;verticalAlign=top;spacingTop=-4;" vertex="1" parent="cache-title"><mxGeometry x="0" y="0" width="1840" height="42" as="geometry" /></mxCell>
        <mxCell id="cache-t-2" value="Three cache levels, checked from the cheapest (whole run) to the most specific (single Glue job)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=16;align=left;verticalAlign=top;spacingTop=-4;" vertex="1" parent="cache-title"><mxGeometry x="5" y="40" width="1840" height="25" as="geometry" /></mxCell>
