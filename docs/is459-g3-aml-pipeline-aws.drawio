        <mxCell id="legend-title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" value="How a run works" vertex="1">
          <mxGeometry height="26" width="400" x="40" y="1166" as="geometry" />
        </mxCell>
        <mxCell id="leg-badge-1" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FF9900;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" value="1" vertex="1">
          <mxGeometry height="28" width="28" x="40" y="1204" as="geometry" />
        </mxCell>
        <mxCell id="leg-text-1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" value="&lt;b&gt;Operator sign-in and launch&lt;/b&gt; – IAM-authorised bootstrap, then session exchange; dashboard-control keeps sessions and the launch lock in DynamoDB and starts is459-g3-cloud-ingest." vertex="1">
          <mxGeometry height="36" width="1060" x="80" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="leg-badge-2" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FF9900;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" value="2" vertex="1">
          <mxGeometry height="28" width="28" x="40" y="1254" as="geometry" />
        </mxCell>
        <mxCell id="leg-text-2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" value="&lt;b&gt;Cloud acquisition&lt;/b&gt; – A container-image Lambda downloads the Kaggle AML files and historical FX and writes them with a manifest to the private pipeline bucket. If an identical request was already published, the run ends at the existing release with no batch; the control Lambda re-checks that release and shows it on the matching page (HI-Large on the main dashboard, other runs on the demo page)." vertex="1">
          <mxGeometry height="36" width="1060" x="80" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="leg-badge-3" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FF9900;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" value="3" vertex="1">
          <mxGeometry height="28" width="28" x="40" y="1304" as="geometry" />
        </mxCell>
        <mxCell id="leg-text-3" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" value="&lt;b&gt;Start the verified batch&lt;/b&gt; – cloud-ingest starts is459-g3-ingest synchronously. Opt-in: uploading raw/trigger.json → EventBridge → raw-trigger starts it once per run ID." vertex="1">
          <mxGeometry height="36" width="1060" x="80" y="1300" as="geometry" />
        </mxCell>
        <mxCell id="leg-badge-4" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FF9900;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" value="4" vertex="1">
          <mxGeometry height="28" width="28" x="40" y="1354" as="geometry" />
        </mxCell>
        <mxCell id="leg-text-4" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" value="&lt;b&gt;Curate&lt;/b&gt; – Glue joins FX, computes earlier-event-only behaviour features and writes date-partitioned Parquet registered in the Glue Data Catalog." vertex="1">
          <mxGeometry height="36" width="1060" x="80" y="1350" as="geometry" />
        </mxCell>
        <mxCell id="leg-badge-5" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FF9900;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" value="5" vertex="1">
          <mxGeometry height="28" width="28" x="40" y="1404" as="geometry" />
        </mxCell>
        <mxCell id="leg-text-5" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" value="&lt;b&gt;Parallel branches&lt;/b&gt; – Glue rule baseline (optional SageMaker candidate training); Glue frozen XGBoost delta1 scoring of every row, 179,702,229 on HI-Large (BQ1); Glue mule-network detection (BQ2). Verified stages are reused from the stage cache (up to 50M rows)." vertex="1">
          <mxGeometry height="36" width="1060" x="80" y="1400" as="geometry" />
        </mxCell>
        <mxCell id="leg-badge-6" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FF9900;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" value="6" vertex="1">
          <mxGeometry height="28" width="28" x="1160" y="1204" as="geometry" />
        </mxCell>
        <mxCell id="leg-text-6" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" value="&lt;b&gt;Reconcile and export&lt;/b&gt; – the lean, checkpointed Glue export recomputes the model scores and network tables, withholds oversized groups as private evidence and builds the release; nothing is released unless every check passes. Begin can resume a failed run from verified stages." vertex="1">
          <mxGeometry height="36" width="1060" x="1200" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="leg-badge-7" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FF9900;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" value="7" vertex="1">
