  <diagram id="bq1" name="2 · BQ1 zoom: AML review ranking">
    <mxGraphModel dx="1717" dy="1041" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2540" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bq1-title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=28;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;fontStyle=1;" value="BQ1 zoom: ranking every transaction for AML review" vertex="1">
          <mxGeometry x="40" y="18" width="1600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="bq1-subtitle" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=light-dark(#545B64,#B8BCC2);fontFamily=Helvetica;fontStyle=0;" value="How the model gives every transaction a risk score, and how the result is double-checked before it reaches the dashboard." vertex="1">
          <mxGeometry x="40" y="58" width="1800" height="26" as="geometry" />
        </mxCell>
        <mxCell id="bq1-note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=light-dark(#545B64,#B8BCC2);fontFamily=Helvetica;fontStyle=0;" value="&lt;b&gt;Question&lt;/b&gt; Which transactions should compliance review first? &amp;nbsp;·&amp;nbsp; &lt;b&gt;Output&lt;/b&gt; a risk score from 0 to 1 for each transaction (higher = review sooner) and a top-2,000 review list" vertex="1">
