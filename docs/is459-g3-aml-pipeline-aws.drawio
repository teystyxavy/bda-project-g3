        <mxCell id="leg-text-7" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" value="&lt;b&gt;Publish and serve&lt;/b&gt; – The control Lambda verifies hashes, saves a new release and moves a pointer: HI-Large runs go to the main dashboard, every other run to the demo page (?view=demo). CloudFront serves the private S3 origin through Origin Access Control." vertex="1">
          <mxGeometry height="36" width="1060" x="1200" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="leg-badge-8" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FF9900;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" value="8" vertex="1">
