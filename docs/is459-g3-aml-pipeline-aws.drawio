        <mxCell id="leg-text-9" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" value="&lt;b&gt;Failure alerts&lt;/b&gt; – A failed stage publishes to SNS is459-g3-failures (email); paid jobs are never retried." vertex="1">
          <mxGeometry height="36" width="1060" x="1200" y="1350" as="geometry" />
        </mxCell>
        <mxCell id="leg-badge-10" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FF9900;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" value="10" vertex="1">
