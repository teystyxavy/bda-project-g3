        <mxCell id="leg-text-8" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" value="&lt;b&gt;Status API&lt;/b&gt; – Public read-only GET /status shows live progress of the executions." vertex="1">
          <mxGeometry height="36" width="1060" x="1200" y="1300" as="geometry" />
        </mxCell>
        <mxCell id="leg-badge-9" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FF9900;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" value="9" vertex="1">
