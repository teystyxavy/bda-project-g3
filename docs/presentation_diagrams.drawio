          <mxGeometry height="52" width="162" x="4" y="46" as="geometry" />
        </mxCell>
        <mxCell id="kin" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#111A2B;strokeColor=#9D6BFF;strokeWidth=1.5;verticalAlign=top;spacingTop=2;fontStyle=1;fontSize=11;fontColor=#9D6BFF;fontFamily=Helvetica;" value="Amazon Kinesis Data Streams" vertex="1">
