          <mxGeometry height="900" width="1600" as="geometry" />
        </mxCell>
        <mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=28;fontColor=#E6EAF0;fontFamily=Helvetica;fontStyle=1;spacing=0;" value="Streaming extension · Score each transaction as it arrives" vertex="1">
          <mxGeometry height="40" width="1520" x="40" y="22" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#9AA4B2;fontFamily=Helvetica;fontStyle=0;spacing=0;" value="A separate, optional path. It reuses the same frozen BQ1 model, so it changes WHEN a transaction is scored, not HOW well. The batch pipeline does not depend on it." vertex="1">
          <mxGeometry height="24" width="1520" x="40" y="62" as="geometry" />
        </mxCell>
        <mxCell id="status" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#2A2418;strokeColor=#FF9900;strokeWidth=1.5;fontSize=12;fontColor=#E6EAF0;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" value="&lt;b&gt;Status:&lt;/b&gt; the delta1 replay of 7 Nov 2026 (984 of 984 HI-Medium transactions, 744 on HI-Large, all 15 behaviour features matched batch) is reconciled and shown on the live &lt;b&gt;Incoming AML&lt;/b&gt; tab. The stream is now &lt;b&gt;parked&lt;/b&gt; to save cost: the Kinesis shard is deleted and the consumer is off. Terraform can restore it in one apply. Input is a &lt;b&gt;replay&lt;/b&gt; of past transactions, not a live bank feed." vertex="1">
          <mxGeometry height="44" width="1520" x="40" y="104" as="geometry" />
        </mxCell>
        <mxCell id="replay" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=none;strokeColor=#9AA4B2;dashed=1;" value="" vertex="1">
