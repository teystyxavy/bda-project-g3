        <mxCell id="leg-t0" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#E6EAF0;fontFamily=Helvetica;fontStyle=0;spacing=0;" value="&lt;b&gt;Verify (Glue export)&lt;/b&gt; – recomputes BQ1 scores and BQ2 tables with separate code, measures BQ1 accuracy against the rule baseline, then builds the dashboard release. Same gate for both BQs." vertex="1">
          <mxGeometry height="38" width="1482" x="78" y="730" as="geometry" />
        </mxCell>
        <mxCell id="leg-b1" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FF9900;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" value="5" vertex="1">
